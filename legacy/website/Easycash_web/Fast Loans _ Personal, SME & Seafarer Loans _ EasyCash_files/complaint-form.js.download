jQuery(document).ready(function($) {
    $('form').submit(function(event) {
        event.preventDefault();

        var formData = new FormData(this);

        $.ajax({
            url: "https://easycash.ph/wp-admin/admin-ajax.php",
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                $('#responseMessage')
                    .text(response)
                    .css('color', response.includes('successfully') ? 'green' : 'red')
                    .fadeIn().delay(5000).fadeOut();
            },
            error: function() {
                $('#responseMessage')
                    .text('An error occurred, please try again later.')
                    .css('color', 'red')
                    .fadeIn().delay(5000).fadeOut();
            }
        });
    });
});
