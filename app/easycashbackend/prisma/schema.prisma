// ============================================================================
// EasyCash Digital Lending Platform — Database Schema
// ============================================================================
// Authoritative source: repository-root `docs/` — Phase 0 Discovery, Phase 1
// Core Domain Model, Domain Glossary, Phase 1.5 Domain Invariants, and the
// Architecture Decision Register (ADR).
//
// Every model cites the rule ID(s) / ADR(s) it implements or provisionally
// works around. Do not add a field, enum value, or table that is not
// traceable to that specification (Phase 1.5 rules FIN-5 / MIG-5).
//
// Explicitly out of scope for this schema (tracked, not forgotten):
// CustomField/CustomFieldValue, Guarantor (ADR-040), Group-held loans
// (ADR-004 — individual Borrower-held loans only, see LoanAccount below),
// Restructuring/Renewal/Write-off/Early-Settlement/Holiday-Rule structures
// (ADR-041), CIC submission tables, full RBAC policy engine (ADR-038).
//
// Working assumption pending resolution: ADR-032 (Loan Release vs.
// Disbursement) — this schema treats them as two distinct moments; see
// the comment on LoanAccount below.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums — every value is directly evidenced in Phase 0 legacy data or
// explicitly named in PROJECT_RULES.md. None are invented. Adding a value
// later is a normal migration, not a redesign.
// ----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BorrowerStatus {
  ACTIVE
  INACTIVE
}

enum AddressOwnerType {
  BORROWER
  CO_BORROWER
}

enum AttachmentOwnerType {
  BORROWER
  LOAN_ACCOUNT
  /// Added 2026-07-10 for the Loan Application intake attachment-upload feature — a scanned
  /// supporting document (payslip, valid ID, etc.) attached before a Borrower/LoanAccount exists.
  LOAN_APPLICATION
  /// Added 2026-07-31 for the Portal<->LMS support chat (user request) - a file attached to one
  /// ChatMessage.
  CHAT_MESSAGE
}

/// Tags a Loan Application intake attachment by what it actually is (valid ID vs. payslip vs.
/// profile picture, etc.) so a future risk-scoring feature can look up specific documents by type
/// instead of an undifferentiated attachment list. Nullable on Attachment — manual uploads via the
/// generic Attachments panel have no category.
enum AttachmentDocumentCategory {
  PROFILE_PICTURE
  VALID_ID_BORROWER
  VALID_ID_CO_BORROWER
  PROOF_OF_BILLING
  EMPLOYEE_ID
  BUSINESS_CLEARANCE
  CORPORATE_PAYSLIP
  SEAMANS_BOOK
  OVERSEAS_EMPLOYMENT_CERTIFICATE
  /// 2026-07-31 (user request): a catch-all "Other" upload slot offered per loan product on the
  /// Portal application form (Business/Salary/Seafarer each get one) - always optional/
  /// supplementary, never counted toward the "documents complete" check.
  OTHER_SUPPORTING_DOCUMENT
  /// 2026-08-14 (user request): a client-submitted receipt/screenshot for a Bank Transfer payment
  /// to Easycash's official bank account, uploaded from the Portal Dashboard against their (sole)
  /// active LoanAccount - so staff can reconcile it without relying on the collections@ inbox.
  PAYMENT_PROOF
}

/// LP-1: a Loan Product Version has exactly one interest calculation method.
enum InterestCalculationMethod {
  FLAT
  DECLINING_BALANCE
  DECLINING_BALANCE_DISCOUNTED
}

enum InterestType {
  SIMPLE_INTEREST
}

enum RepaymentScheduleMethod {
  FIXED
}

enum RepaymentPeriodUnit {
  MONTHS
}

enum SettlementOption {
  FULL_DUE_AMOUNTS
}

/// FIN-4: rounding behavior is defined per product and applied consistently.
enum RoundingMethod {
  NO_ROUNDING
  ROUND_REMAINDER_INTO_LAST_REPAYMENT
}

/// PEN-1: penalty calculation method is configurable per product.
enum PenaltyCalculationMethod {
  NONE
  OVERDUE_BALANCE_AND_INTEREST
  ON_REPAYMENT
}

/// FEE-2: a fee's amount is flat or a percentage — never hard-coded per loan.
enum FeeCalculationMethod {
  FLAT
  PERCENTAGE_OF_LOAN_AMOUNT
}

/// FEE-3: a fee applies only at its configured trigger point.
enum FeeTriggerEvent {
  DISBURSEMENT
  MANUAL
  CAPITALIZED_DISBURSEMENT
}

enum FeeApplicationType {
  REQUIRED
  OPTIONAL
}

/// LA-2 / ADR-011: lean, legacy-observed lifecycle (recommended option) —
/// the fuller PROJECT_RULES.md workflow (Draft/Submitted/Under
/// Review/Released/Cancelled) is deferred per ADR-011 until confirmed.
enum LoanAccountStatus {
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  ACTIVE_IN_ARREARS
  CLOSED
  CLOSED_WRITTEN_OFF
  CLOSED_REJECTED
  /// 2026-07-24 (Loan Restructure feature, user-confirmed): a past-due/matured ACTIVE or
  /// ACTIVE_IN_ARREARS loan closed because its remaining balance became the principal of a brand
  /// new LoanAccount (see the LoanRestructure model). Distinct from CLOSED (fully paid off) and
  /// CLOSED_WRITTEN_OFF (loss realized) — this loan's balance was neither collected nor lost, it
  /// moved to a new account.
  CLOSED_RESTRUCTURED
  /// 2026-07-24 (Loan Adjustment feature, user-confirmed): an ACTIVE loan with zero payments made
  /// and still before its first installment's due date, closed because a brand new LoanAccount was
  /// created with the exact same principal/rate/term/product, only the first due date changed (see
  /// the LoanAdjustment model). Distinct from CLOSED_RESTRUCTURED - no balance/principal change at
  /// all here, purely a due-date correction.
  CLOSED_ADJUSTED
  /// 2026-08-07..08 (Undo Restructure / Undo Adjustment feature): DEPRECATED, unused going forward
  /// - kept only because Postgres cannot drop an enum value without recreating the type. The
  /// original "retire, don't delete" undo design that produced this status was revised the same
  /// day (user-confirmed): undo now deletes the NEW loan account outright instead. Never written
  /// by application code anymore; no LoanAccount row should carry this value after 2026-08-08.
  CLOSED_UNDONE
}

/// TXN-1..2: append-only ledger entry types. Note: "DISBURSEMENT" is
/// spelled correctly here — the legacy `DISBURSMENT` typo is a
/// migration-mapping concern only, never reproduced in this new schema.
enum LoanTransactionType {
  DISBURSEMENT
  REPAYMENT
  FEE_CHARGED
  PENALTY_APPLIED
  INTEREST_APPLIED
  DEFERRED_INTEREST_APPLIED
  DEFERRED_INTEREST_PAID
  TRANSFER
  ADJUSTMENT
  REVERSAL
  /// 2026-08-15 — MIGRATED DATA ONLY. Never produced by this system's own payment flow.
  ///
  /// SDevTech splits one borrower payment into several transactions, one per component: paying
  /// ₱7,936 covering a ₱936 fee arrives there as a `FEE_REPAYMENT` of ₱936 plus a `REPAYMENT` of
  /// ₱7,000. This system deliberately does the opposite (TXN-1: one financial event, one row) —
  /// `ProcessPaymentUseCase` records a single REPAYMENT whose `feesComponent`/`penaltyComponent`
  /// carry that split, with `PaymentAllocation` holding the per-installment detail.
  ///
  /// These two values exist only so migrated history keeps SDevTech's own labelling instead of
  /// being flattened into `ADJUSTMENT` alongside genuine staff corrections (write-offs, undos,
  /// due-amount reductions) — a real client payment and a manual correction are different events
  /// and must stay distinguishable in reports and audits. See scripts/relabel-legacy-repayment-
  /// transaction-types.ts for the retroactive fix and TRANSACTION_TYPE_MAP in
  /// scripts/migrate-legacy-data.ts for how new imports are mapped.
  FEE_REPAYMENT
  PENALTY_REPAYMENT
}

/// REPAY-3: status must be derivable from due/paid amounts and due date.
enum RepaymentInstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  LATE
}

// ----------------------------------------------------------------------------
// Identity & Access — ADR-038 (RBAC minimal placeholder, full design
// deferred), ADR-039 (no legacy password hash carry-over — this is a new
// system; User.legacyId exists only for identity traceability), AUDIT-3
// (configurable permissions, no hard-coded role checks), AUDIT-4 (minimum
// role baseline)
// ----------------------------------------------------------------------------

/// ADR-005 (Critical/Blocking, resolved 2026-08-04): Easycash operates a single branch
/// ("Head Office") - user-confirmed, no further branch list to come.
model Branch {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  /// Physical office address — used to geocode the branch once (see
  /// LoanApplicationPreQualificationService) for the loan-application distance rule.
  address   String?
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  borrowers        Borrower[]
  loanAccounts     LoanAccount[]
  transactions     LoanTransaction[]
  loanApplications LoanApplication[]
  notifications    Notification[]

  @@map("branches")
}

model User {
  id           String     @id @default(uuid())
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id])
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)

  /// Self-service profile fields (2026-07-12) - editable by the user themselves via
  /// `PATCH /users/me`, distinct from the MIS-only admin fields above (email/status/roles/
  /// companyId), which stay behind `PATCH /users/:id`.
  contactNumber String?
  address       String?
  birthday      DateTime?

  /// Settings > Security > Two-Factor Authentication (2026-07-22, user request). `twoFactorChannel`
  /// is null until `twoFactorEnabled` is first turned on (ConfirmTwoFactorSetupUseCase sets both
  /// together) - "EMAIL" or "SMS", never both at once, matching the picker in Settings. Defaults to
  /// disabled: 2FA changes login behavior app-wide, so it must be an explicit per-user opt-in, not
  /// a silent migration-time flip that could lock anyone out.
  twoFactorEnabled Boolean @default(false)
  twoFactorChannel String?

  /// Internal employee/company ID (HR identifier) - distinct from `id` (the DB primary key) and
  /// `legacyId` (the migrated-system's own ID). Optional - existing migrated/seeded staff don't
  /// have one recorded yet.
  companyId String? @unique

  /// Organizational job-title label under the user's Role (e.g. "MIS Manager") - display/
  /// organizational only, does not affect access (see RoleClass doc comment).
  roleClassId String?
  roleClass   RoleClass? @relation(fields: [roleClassId], references: [id], onDelete: SetNull)

  /// Identity traceability only (Mambu `mambu_users` / SDevTech `users`).
  /// Credentials themselves are never migrated — ADR-039.
  legacyId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles                                UserRole[]
  refreshTokens                        RefreshToken[]
  twoFactorChallenges                  TwoFactorChallenge[]
  trustedDevices                       TrustedDevice[]
  auditLogs                            AuditLog[]
  profileActivityLogs                  ProfileActivityLog[]          @relation("ProfileActivityLogUser")
  borrowersAsLoanOfficer               Borrower[]                    @relation("BorrowerLoanOfficer")
  loanAccountsAsOfficer                LoanAccount[]                 @relation("LoanAccountOfficer")
  loanAccountsApproved                 LoanAccount[]                 @relation("LoanAccountApprovedBy")
  transactionsPosted                   LoanTransaction[]             @relation("LoanTransactionPostedBy")
  attachmentsUploaded                  Attachment[]                  @relation("AttachmentUploadedBy")
  profileNotesAuthored                 ProfileNote[]                 @relation("ProfileNoteAuthor")
  idempotencyKeys                      IdempotencyKey[]
  loanApplicationsEncoded              LoanApplication[]             @relation("LoanApplicationEncodedBy")
  loanApplicationsReviewed             LoanApplication[]             @relation("LoanApplicationReviewedBy")
  loanApplicationReviewsStarted        LoanApplication[]             @relation("LoanApplicationReviewStartedBy")
  loanApplicationsPreApproved          LoanApplication[]             @relation("LoanApplicationPreApprovedBy")
  loanNotesAuthored                    LoanNote[]
  loanDocumentsGenerated               GeneratedLoanDocument[]       @relation("LoanDocumentGeneratedBy")
  loanSigningSessionsCreated           LoanSigningSession[]          @relation("LoanSigningSessionCreatedBy")
  statementsOfAccountGenerated         GeneratedStatementOfAccount[] @relation("StatementOfAccountGeneratedBy")
  penaltyOverridesSet                  RepaymentSchedule[]           @relation("PenaltyOverrideBy")
  penaltyReductionsMade                PenaltyReduction[]
  feesOverridesSet                     RepaymentSchedule[]           @relation("FeesOverrideBy")
  feeAdjustmentsMade                   FeeAdjustment[]
  feeChargesMade                       FeeCharge[]
  penaltyChargesMade                   PenaltyCharge[]
  paymentAdjustmentsMade               PaymentAdjustment[]
  loanRestructuresMade                 LoanRestructure[]             @relation("LoanRestructureBy")
  loanAdjustmentsMade                  LoanAdjustment[]              @relation("LoanAdjustmentBy")
  notificationsReceived                Notification[]
  reminderSettingsUpdated              ReminderSettings[]
  systemAnnouncementsCreated           SystemAnnouncement[]
  chatConversationsClaimed             ChatConversation[]            @relation("ChatConversationClaimedBy")
  chatConversationsOriginallyClaimed   ChatConversation[]            @relation("ChatConversationOriginallyClaimedBy")
  chatConversationsPendingTransferTo   ChatConversation[]            @relation("ChatConversationPendingTransferTo")
  chatConversationsPendingTransferFrom ChatConversation[]            @relation("ChatConversationPendingTransferFrom")
  chatMessagesSent                     ChatMessage[]
  chatConversationParticipations       ChatConversationParticipant[]

  @@map("users")
}

model Role {
  id          String  @id @default(uuid())
  /// AUDIT-4 baseline, seeded: MIS, Loan Operation Manager, CRM, Finance,
  /// Accounting, Collection Officer (ADR-038 §1, renamed 2026-07-06 from
  /// the original placeholder list — Administrator, Manager, Loan Officer,
  /// Cashier, Collection Officer, Viewer).
  name        String  @unique
  description String?

  users       UserRole[]
  permissions RolePermission[]
  roleClasses RoleClass[]

  @@map("roles")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Organizational job-title label under a Role (e.g. "MIS Manager"/"MIS Assistant" under the MIS
/// role) - display/organizational only, does NOT affect LMS access; actual permissions remain
/// governed entirely by Role/Permission above (ADR-043's flat role model is unchanged).
model RoleClass {
  id        String   @id @default(uuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@unique([roleId, name])
  @@map("role_classes")
}

/// 2026-07-20 user request: make the Loan Products catalog's "Product Type" groupings (Business
/// Loan, Salary Loan, Seafarer Loan, etc.) renamable. `canonicalKey` is the STABLE identifier -
/// matches `productTypeClassification.ts`'s `PRODUCT_TYPE_DEFS[].type` exactly and is what
/// grouping/filtering logic keys off of; it never changes. `label` is the only renamable field -
/// what officers actually see. Deliberately no prefix/add/delete here (unlike Role Class) - the
/// underlying name-prefix -> type classification rule is unchanged, only its display text is
/// configurable. Seeded 1:1 with the 5 existing canonical types at migration time.
model ProductTypeLabel {
  id           String   @id @default(uuid())
  canonicalKey String   @unique
  label        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("product_type_labels")
}

/// AUDIT-3: permissions must be role-based and configurable in the
/// database, not hard-coded `if role === "Admin"` checks in application code.
model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Secure JWT refresh-token rotation store (Milestone 6).
model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdByIp String?
  /// Settings > Security > Active Sessions (2026-07-21) - captured once at issuance (login) and
  /// carried forward on every rotation (refresh), never re-parsed from a later request. Each
  /// non-revoked, non-expired row IS effectively one logged-in device's "session" - rotation
  /// replaces a device's row in place rather than creating parallel rows for it.
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@map("refresh_tokens")
}

/// Settings > Security > Two-Factor Authentication (2026-07-22, user request) - a short-lived OTP
/// challenge, for either enabling 2FA (`purpose: "ENABLE"`, RequestTwoFactorSetupUseCase /
/// ConfirmTwoFactorSetupUseCase) or completing a 2FA-gated login (`purpose: "LOGIN"`, LoginUseCase
/// / VerifyLoginOtpUseCase). One row per attempt to send a code - never reused across purposes or
/// across a retry, so an old challenge can't be replayed once a fresh one has been issued.
model TwoFactorChallenge {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    String
  channel    String
  /// HMAC-SHA256(code, JWT_REFRESH_SECRET) - same keyed-hash approach as RefreshToken.tokenHash,
  /// not bcrypt: this is compared at most a handful of times (rate-limited by `attempts` below)
  /// against a 6-digit, 5-minute-lived code, so bcrypt's deliberate slowness buys nothing here.
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("two_factor_challenges")
}

/// "Remember this device" (2026-07-30 user request) - an opt-in checkbox on the login OTP step. On
/// success, LoginUseCase/VerifyLoginOtpUseCase issues one of these (30-day expiry) and returns the
/// plaintext token to the client once, for it to store and resend on future logins. A future login
/// presenting a valid, non-expired, matching token skips the 2FA challenge entirely - same
/// keyed-HMAC-hash storage as TwoFactorChallenge.codeHash (never the plaintext token at rest).
model TrustedDevice {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("trusted_devices")
}

// ----------------------------------------------------------------------------
// Easycash Portal — client-facing self-service (2026-07-23, Phase 1: auth foundation only)
// Deliberately its own auth realm, never the `User`/`RefreshToken`/staff-side identity module -
// see PORTAL_JWT_SECRET's doc comment in shared/config/env.ts for why. A PortalAccount is never
// required to have a linked Borrower (open sign-up, per user decision 2026-07-23) - linkage
// happens once/if the account holder's first loan application is approved.
// ----------------------------------------------------------------------------

enum PortalAccountStatus {
  /// Just signed up - email not yet verified via PortalAccountChallenge, cannot log in yet.
  PENDING_VERIFICATION
  ACTIVE
  /// 2026-08-06 (Delete My Portal Account, user request) - self-service deletion of the LOGIN
  /// ONLY, never the linked Borrower/loan data (disclosed to the client at request time) - blocked
  /// entirely while any linked LoanAccount is ACTIVE/ACTIVE_IN_ARREARS (RequestPortalAccountDeletionUseCase).
  /// A soft status flip, not a real row delete - matches this codebase's only existing
  /// deactivation convention (`User.status`), and avoids the FK-restrict failure a real DELETE
  /// would hit on any `LoanApplication.portalAccountId` still pointing at this row.
  DELETED
}

model PortalAccount {
  id              String              @id @default(uuid())
  email           String              @unique
  passwordHash    String
  contactNumber   String?
  status          PortalAccountStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?

  /// 2026-08-06 (Bind existing Client data to Portal, user request) - true when this account's
  /// current password is a staff-issued shared temporary password (see
  /// CreatePortalAccountForBorrowerUseCase), until the client sets their own. The portal frontend
  /// must block access to every other page until this clears - the shared temp password is not a
  /// secret (any staff member can issue it, and it's the same string for every client), so this
  /// flag is the only thing standing between "knows a client's email" and "is logged in as them."
  mustChangePassword Boolean @default(false)

  /// Portal login 2FA (2026-07-30 user request) - unlike the internal LMS's opt-in-default-off
  /// 2FA, this defaults ON: `twoFactorChannel` is populated automatically from whichever channel
  /// the client already verified at sign-up (see VerifySignUpUseCase), so it's never null while
  /// enabled - no separate "first enable" step needed for the common case. A client can still turn
  /// it off (DisablePortalTwoFactorUseCase) or re-enable/switch channel later (RequestEnable/
  /// ConfirmEnablePortalTwoFactorUseCase), mirroring identity's TwoFactorChallenge flow shape.
  twoFactorEnabled Boolean @default(true)
  twoFactorChannel String?

  /// Set once this account is linked to a real Borrower (their first application gets approved
  /// and "Create Client Profile" is run, or an existing client is matched) - null until then.
  borrowerId String?   @unique
  borrower   Borrower? @relation(fields: [borrowerId], references: [id])

  /// Pre-application profile fields (2026-07-30 user request) - lets a client personalize "My
  /// Profile" before ever submitting a loan application (previously the only editable copy of this
  /// data was on a draft LoanApplication, which doesn't exist until they apply). Same field
  /// shape/types as the real Borrower record so GetPortalProfileUseCase/UpdatePortalProfileUseCase
  /// can present both through one PortalProfileDto shape. Once `borrowerId` is set, these columns
  /// become dormant - the Borrower record is authoritative from then on and these are never synced
  /// back into it (a fresh signup vs. an existing client's history are different sources of truth;
  /// reconciling them isn't this feature's job).
  firstName        String?
  middleName       String?
  lastName         String?
  suffix           String?
  gender           String?
  birthDate        DateTime?
  placeOfBirth     String?
  nationality      String?
  civilStatus      String?
  homeOwnership    String?
  mobilePhone1     String?
  mobilePhone2     String?
  occupation       String?
  employer         String?
  monthlyIncome    Decimal?  @db.Decimal(14, 2)
  /// 2026-07-31 (user request) - "Office address" on the Employment section, same concept as
  /// Borrower's incomeDetail.employerAddress once linked.
  officeAddress    String?
  tinNumber        String?
  sssNumber        String?
  /// {name, age, relationship}[] - same shape as Borrower.dependants/LoanApplication.dependants.
  dependants       Json?
  reference1Name   String?
  reference1Mobile String?
  reference2Name   String?
  reference2Mobile String?
  houseUnitNumber  String?
  street           String?
  barangay         String?
  cityMunicipality String?
  province         String?
  zipCode          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challenges        PortalAccountChallenge[]
  loanApplications  LoanApplication[]
  notifications     PortalNotification[]
  trustedDevices    PortalTrustedDevice[]
  chatConversations ChatConversation[]

  @@map("portal_accounts")
}

/// Notification Center for the Easycash Portal (2026-07-24 user request) - same append-only-
/// except-`read` shape as the staff Notification model, scoped to a PortalAccount instead of a
/// User. Created as a side effect of a real domain event (today: only the loan application
/// Approve/Decline decisions - see ApproveLoanApplicationUseCase/DeclineLoanApplicationUseCase's
/// optional `portalNotificationService` dep), never fabricated.
model PortalNotification {
  id              String        @id @default(uuid())
  portalAccountId String
  portalAccount   PortalAccount @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)
  /// 'APPLICATION_APPROVED' | 'APPLICATION_DECLINED' | 'LOAN_ACCOUNT_APPROVED' |
  /// 'LOAN_ACCOUNT_DISBURSED' | 'LOAN_ACCOUNT_REJECTED' - client-facing milestones only (user's
  /// explicit choice, 2026-07-24 + 2026-08-14), not every intermediate review stage.
  type            String
  title           String
  body            String?
  entityType      String?
  entityId        String?
  read            Boolean       @default(false)
  readAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([portalAccountId, read, createdAt])
  @@map("portal_notifications")
}

/// Portal<->LMS support chat (2026-07-31 user request) - a call-center-style claim queue, not a
/// generic open inbox. One conversation per "session" a client starts (they resume their existing
/// WAITING/CLAIMED one rather than starting a second); `requiresManager` distinguishes the normal
/// claim-eligible queue (Collection Officer role, or Loan Operation Manager) from one a staff
/// member has explicitly transferred up (visible only to Loan Operation Manager, or a Collection
/// Officer whose RoleClass is "Collection Manager" - see ChatEligibility.ts for the exact,
/// business-confirmed mapping onto real roles/role classes).
enum ChatConversationStatus {
  WAITING
  CLAIMED
  /// 2026-07-31 (user request, transfer redesign) - a transfer has been started (PIN set, target
  /// picked) but not yet confirmed by the receiving officer; the current claimant can no longer
  /// send while in this state.
  PENDING_TRANSFER
  CLOSED
}

/// 2026-07-31 (user request, transfer redesign): a claim no longer feeds back into a shared
/// manager queue - the current claimant hands off DIRECTLY to a specific person they pick (any
/// LMS user, via Role -> Role Class -> user), confirmed by a 4-digit PIN both sides can see in
/// their own UI (a deliberate two-actor confirmation gesture against an accidental take-over
/// click, NOT a cryptographic secret - see pendingTransferPin's own doc comment for why it's
/// stored plaintext).
model ChatConversation {
  id                        String                        @id @default(uuid())
  portalAccountId           String
  portalAccount             PortalAccount                 @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)
  status                    ChatConversationStatus        @default(WAITING)
  claimedByUserId           String?
  claimedByUser             User?                         @relation("ChatConversationClaimedBy", fields: [claimedByUserId], references: [id])
  claimedAt                 DateTime?
  /// Set once, the first time this conversation is claimed from WAITING - never changed again,
  /// even across further transfers. Lets the very first responder still see (read-only) the
  /// whole conversation history after handing it off, instead of losing all trace of it.
  originalClaimedByUserId   String?
  originalClaimedByUser     User?                         @relation("ChatConversationOriginallyClaimedBy", fields: [originalClaimedByUserId], references: [id])
  pendingTransferToUserId   String?
  pendingTransferToUser     User?                         @relation("ChatConversationPendingTransferTo", fields: [pendingTransferToUserId], references: [id])
  pendingTransferFromUserId String?
  pendingTransferFromUser   User?                         @relation("ChatConversationPendingTransferFrom", fields: [pendingTransferFromUserId], references: [id])
  /// Deliberately plaintext, 4 digits - the intended recipient already sees this same value in
  /// their own "Incoming Transfers" list (it's not hidden from them), so hashing it would only
  /// prevent displaying it back, not add real access control. This is a confirmation gesture
  /// (proves the receiving officer actually opened the specific handoff meant for them) more
  /// than a secret - the real access control is `pendingTransferToUserId` itself.
  pendingTransferPin        String?
  closedAt                  DateTime?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  messages                  ChatMessage[]
  participants              ChatConversationParticipant[]

  @@index([status, createdAt])
  @@index([claimedByUserId])
  @@index([originalClaimedByUserId])
  @@index([pendingTransferToUserId])
  @@index([portalAccountId, status])
  @@map("chat_conversations")
}

/// 2026-08-03 (user request: "gusto ko maging trackable talaga ang chat logs") - one row per
/// hand-off, every staff member who has EVER been the claimant, not just the first and current
/// one (which `originalClaimedByUserId`/`claimedByUserId` alone can't reconstruct across more than
/// one transfer). Written alongside claim/transfer/close, never edited afterward - append-only
/// audit trail, same posture as AuditLog.
model ChatConversationParticipant {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  joinedAt       DateTime         @default(now())
  /// Null while this is the CURRENT claimant's still-open span.
  leftAt         DateTime?
  /// 'TRANSFERRED' | 'CLOSED' - null while still open.
  leftReason     String?

  @@index([conversationId, joinedAt])
  @@index([userId])
  @@map("chat_conversation_participants")
}

enum ChatMessageSenderType {
  PORTAL_ACCOUNT
  STAFF
  /// An automatic narration of a real event (claimed/transferred/closed, who/when) - never a
  /// fabricated message, always generated as a direct side effect of the action it describes.
  SYSTEM
}

model ChatMessage {
  id             String                @id @default(uuid())
  conversationId String
  conversation   ChatConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     ChatMessageSenderType
  senderUserId   String?
  senderUser     User?                 @relation(fields: [senderUserId], references: [id])
  body           String?
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

/// Same opaque-OTP-challenge shape as `TwoFactorChallenge` (see that model's own doc comment for
/// the hashing rationale) - a separate table rather than a shared/polymorphic one because it
/// belongs to a PortalAccount, not a User, and these two auth realms must never share storage any
/// more than they share JWT secrets.
model PortalAccountChallenge {
  id              String        @id @default(uuid())
  portalAccountId String
  portalAccount   PortalAccount @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)
  /// 'SIGNUP' (verify email/contact before first login) | 'PASSWORD_RESET' | 'LOGIN' (2FA-gated
  /// login, 2026-07-30) | 'ENABLE_2FA' (re-enable/switch channel, 2026-07-30).
  purpose         String
  /// 'EMAIL' | 'SMS' | 'BOTH' (2026-07-30 user request: same code sent to both channels at once -
  /// SIGNUP always uses this when a contact number was given; LOGIN/ENABLE_2FA only when the
  /// account's own twoFactorChannel preference is 'BOTH').
  channel         String
  codeHash        String
  expiresAt       DateTime
  attempts        Int           @default(0)
  consumedAt      DateTime?
  createdAt       DateTime      @default(now())

  @@index([portalAccountId])
  @@map("portal_account_challenges")
}

/// "Remember this device" (2026-07-30 user request) - Portal's own version of `TrustedDevice`, same
/// shape/reasoning, kept as a separate table since this auth realm never shares storage with the
/// staff-side identity module.
model PortalTrustedDevice {
  id              String        @id @default(uuid())
  portalAccountId String
  portalAccount   PortalAccount @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)
  tokenHash       String        @unique
  expiresAt       DateTime
  createdAt       DateTime      @default(now())

  @@index([portalAccountId])
  @@map("portal_trusted_devices")
}

// ----------------------------------------------------------------------------
// Loan Product — LP-1..5, LPV-1..4
// ADR-002: no retroactive reconstruction of legacy product-version history
// (recommended option adopted) — versioning is formal starting now.
// ADR-003: full version lineage (recommended option adopted).
// ADR-009: repayment allocation order — mechanism only, PENDING value.
// ----------------------------------------------------------------------------

/// Stable product identity only — see LoanProductVersion for the actual
/// versioned, immutable rule set (LPV-1).
model LoanProduct {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  /// BSP Circular 1133 / SEC MC 3 (2022-07-20, confirmed with the user against
  /// `legacy/SEC/BSP1133.pdf` and the SEC FAQ) — one of the four criteria that together determine
  /// whether a loan is "covered" by the interest/penalty/EIR/total-cost ceilings: "unsecured,
  /// general-purpose loan". A product-level classification (not per-version — whether a product is
  /// secured/specific-purpose doesn't change across pricing versions). Confirmed true so far only
  /// for SP-Flash, SL-LAZ, SML-REG, PFL-GAD (2026-07-20 user confirmation) — every other product
  /// defaults to `false` (NOT confirmed unsecured/general-purpose, not "confirmed secured") pending
  /// review; see ADR-053 §2 for the full list and status. Never inferred/guessed for a product not
  /// explicitly confirmed by the user (CLAUDE.md: never fabricate financial/compliance logic).
  isUnsecuredGeneralPurpose Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions              LoanProductVersion[]
  documentTemplateLinks DocumentTemplateMapping[]

  @@map("loan_products")
}

/// 2026-07-11 (Create Loan Account, Contractual Rate auto-fill): staff enters an Add-On Rate and
/// Term; the Contractual Rate actually used to run the declining-balance schedule (§1/§2 of
/// CALCULATION_ENGINE_SPEC.md) is looked up here rather than typed. Sourced directly from MIS
/// Nomer's own Excel LMS (`legacy/reports/BETA 1.5.83 LMSv3.xlsm`, sheet `Rate_details`) — real
/// data, not invented; one confirmed typo (Add-On 1.75%, Term 3: "242" -> 2.42) corrected with the
/// user's explicit confirmation before seeding. Global (not per-product) — no product column
/// exists in the source table; revisit if a per-product chart is ever needed.
model InterestRateChart {
  id                     String  @id @default(uuid())
  addOnRatePercent       Decimal @db.Decimal(6, 3)
  termMonths             Int
  contractualRatePercent Decimal @db.Decimal(6, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([addOnRatePercent, termMonths])
  @@map("interest_rate_chart")
}

/// LPV-1: every approved LoanAccount references a specific, immutable
/// version. Editing a product never affects loans already approved under
/// a prior version (LPV-3).
model LoanProductVersion {
  id            String      @id @default(uuid())
  loanProductId String
  loanProduct   LoanProduct @relation(fields: [loanProductId], references: [id])
  versionNumber Int

  /// ADR-003: full lineage — self-referencing predecessor link.
  previousVersionId String?             @unique
  previousVersion   LoanProductVersion? @relation("LoanProductVersionLineage", fields: [previousVersionId], references: [id])
  nextVersion       LoanProductVersion? @relation("LoanProductVersionLineage")

  /// LPV-2 (Hard Rule): only one version of a product may be Active at a
  /// time. Enforced at TWO layers, not one: the application layer
  /// (Milestone 7 use cases), AND, as of the Schema Review follow-up
  /// migration (Schema Review SR-30), a PostgreSQL partial unique index —
  /// `CREATE UNIQUE INDEX ... ON loan_product_versions(loanProductId)
  /// WHERE isActive = true` — added via raw SQL in
  /// prisma/migrations/20260702010000_schema_review_indexes_and_lpv2_guard.
  /// This lives in a hand-written SQL migration, NOT here as `@@unique`,
  /// because Prisma's schema DSL has no way to express a *conditional*
  /// (partial/filtered) unique constraint — `@@unique`/`@@index` in Prisma
  /// always apply to every row; there is no `WHERE` clause equivalent in
  /// the schema language itself, even though the underlying PostgreSQL
  /// feature (partial indexes) is fully supported when written as raw SQL.
  isActive      Boolean   @default(false)
  effectiveFrom DateTime
  effectiveTo   DateTime?

  interestCalculationMethod InterestCalculationMethod
  interestType              InterestType              @default(SIMPLE_INTEREST)
  /// Only one convention evidenced in legacy data (E30_360); kept as a
  /// plain string rather than a single-value enum pending confirmation
  /// that no other convention is ever used.
  daysInYearConvention      String                    @default("E30_360")
  repaymentScheduleMethod   RepaymentScheduleMethod   @default(FIXED)
  repaymentPeriodUnit       RepaymentPeriodUnit       @default(MONTHS)
  settlementOption          SettlementOption          @default(FULL_DUE_AMOUNTS)

  loanAmountMin     Decimal  @db.Decimal(14, 2)
  loanAmountMax     Decimal? @db.Decimal(14, 2)
  loanAmountDefault Decimal? @db.Decimal(14, 2)

  installmentCountMin     Int
  installmentCountMax     Int?
  installmentCountDefault Int?

  /// Legacy data shows grace periods effectively unused (type NONE across
  /// nearly all products) — kept configurable, not removed.
  gracePeriodType        String @default("NONE")
  gracePeriodDefaultDays Int    @default(0)

  roundingMethod RoundingMethod @default(NO_ROUNDING)

  /// ADR-009 PENDING: column exists so the mechanism is in place; no
  /// default value or split-calculation logic is implemented until the
  /// actual legacy allocation order is confirmed (Milestone 7 will stop
  /// and ask before implementing this specific calculation).
  repaymentAllocationOrder Json?

  defaultInterestRate Decimal? @db.Decimal(6, 3)
  minInterestRate     Decimal? @db.Decimal(6, 3)
  maxInterestRate     Decimal? @db.Decimal(6, 3)

  legacyId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  penaltyRule      PenaltyRule?
  feeRules         FeeRule[]
  loanAccounts     LoanAccount[]
  loanApplications LoanApplication[]

  @@unique([loanProductId, versionNumber])
  @@map("loan_product_versions")
}

/// PEN-1..4. ADR-008 PENDING: capPercent is a mechanism only (matches the
/// legacy `penalty_rate.maximum` field, which existed but was unused in
/// all 44 sampled products) — not enforced by default until the cap
/// policy decision is made.
model PenaltyRule {
  id                   String                   @id @default(uuid())
  loanProductVersionId String                   @unique
  loanProductVersion   LoanProductVersion       @relation(fields: [loanProductVersionId], references: [id])
  calculationMethod    PenaltyCalculationMethod @default(NONE)
  ratePercent          Decimal?                 @db.Decimal(6, 3)
  capPercent           Decimal?                 @db.Decimal(6, 3)
  gracePeriodDays      Int                      @default(0)

  @@map("penalty_rules")
}

/// FEE-1..4.
model FeeRule {
  id                   String               @id @default(uuid())
  loanProductVersionId String
  loanProductVersion   LoanProductVersion   @relation(fields: [loanProductVersionId], references: [id])
  name                 String
  calculationMethod    FeeCalculationMethod
  triggerEvent         FeeTriggerEvent
  applicationType      FeeApplicationType   @default(REQUIRED)
  flatAmount           Decimal?             @db.Decimal(14, 2)
  percentage           Decimal?             @db.Decimal(6, 3)
  isActive             Boolean              @default(true)

  legacyId  String?  @unique
  createdAt DateTime @default(now())

  appliedFees AppliedFee[]

  @@map("fee_rules")
}

// ----------------------------------------------------------------------------
// Borrower — BOR-1..4
// ADR-001: "Borrower" is the canonical term (recommended option adopted);
// legacy "Client" naming is a migration-mapping concern only.
// ADR-014: Address is polymorphic (Borrower or Co-Borrower) — documented,
// not just assumed.
// ADR-040: Guarantor is out of scope for this schema (deferred).
// ----------------------------------------------------------------------------

model Borrower {
  id                    String  @id @default(uuid())
  branchId              String
  branch                Branch  @relation(fields: [branchId], references: [id])
  assignedLoanOfficerId String?
  assignedLoanOfficer   User?   @relation("BorrowerLoanOfficer", fields: [assignedLoanOfficerId], references: [id])

  /// Set when this Borrower was created via "Create Client Profile" from an APPROVED
  /// LoanApplication (see CreateBorrowerUseCase) - lets the application detail page know a
  /// client already exists for it and prevents creating a duplicate. Null for borrowers created
  /// any other way (e.g. legacy migration, direct walk-in without an application on file).
  sourceApplicationId String?          @unique
  sourceApplication   LoanApplication? @relation("LoanApplicationCreatedBorrower", fields: [sourceApplicationId], references: [id])

  /// Reverse side of LoanApplication.borrowerId (renewal applications started from this client's
  /// own profile) - see that field's doc comment.
  loanApplications LoanApplication[] @relation("LoanApplicationBorrower")

  /// Easycash Portal (2026-07-23, Phase 1) - the client-facing self-service account linked to this
  /// Borrower, once one exists. Null for every Borrower migrated from legacy data or created by
  /// staff without the client ever having signed up on the portal - this is an opt-in linkage, not
  /// a requirement to have a Borrower record at all.
  portalAccount PortalAccount?

  firstName     String
  middleName    String?
  lastName      String
  /// 2026-07-16 (Create Client Account, per the legacy Excel LMS's Client_details sheet).
  suffix        String?
  gender        String?
  birthDate     DateTime?
  placeOfBirth  String?
  nationality   String?
  civilStatus   String?
  homeOwnership String?
  mobilePhone1  String?
  mobilePhone2  String?
  email         String?
  /// 2026-07-16 (Create Client Account) — legacy Excel LMS's Client_details "facebook" column.
  facebookLink  String?
  /// {name, age, relationship}[] - see LoanApplication.dependants doc comment.
  dependants    Json?
  /// Free-text catch-all, carried over from the source LoanApplication's own `note` at Client
  /// Profile creation; also directly editable afterward.
  note          String?
  status        BorrowerStatus @default(ACTIVE)
  loanCycle     Int            @default(0)

  /// 2026-07-18 (Auto SMS Payment Reminders, ADR pending) - opt-out switch. Default true (every
  /// existing/new client is reminded unless they explicitly ask off) - SendPaymentReminderSmsUseCase
  /// skips a Borrower with this false regardless of how many installments are due.
  smsRemindersEnabled Boolean @default(true)

  legacyId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incomeDetail        BorrowerIncomeDetail?
  governmentId        BorrowerGovernmentId?
  identificationDocs  IdentificationDocument[]
  characterReferences CharacterReference[]
  loanAccounts        LoanAccount[]
  /// 2026-07-16 (ADR-015 resolved: per-Borrower, not per-LoanAccount) — see CoBorrower.borrowerId's
  /// own doc comment for why. A client's co-borrowers now belong to them directly; every one of
  /// their loans sees the same list, matching how the legacy sdev system's own co_borrowers.
  /// parent_key already scoped this (to the client, not a specific loan) before migration.
  coBorrowers         CoBorrower[]

  /// Schema Review SR-06/SR-07/SR-08: branch/officer/status filtering and
  /// name/phone search (PROJECT_RULES.md §Search) were previously unindexed.
  @@index([branchId])
  @@index([assignedLoanOfficerId])
  @@index([status])
  @@index([lastName])
  @@index([firstName])
  @@index([mobilePhone1])
  @@map("borrowers")
}

model BorrowerIncomeDetail {
  id               String   @id @default(uuid())
  borrowerId       String   @unique
  borrower         Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  employmentType   String?
  employerName     String?
  employerAddress  String?
  natureOfBusiness String?
  position         String?
  yearsEmployed    Int?
  /// 2026-07-16 (Create Client Account) — legacy Excel LMS's Client_details "Months Employed" column;
  /// yearsEmployed alone (above) already existed, this is the remainder-months half of that pair.
  monthsEmployed   Int?
  monthlyIncome    Decimal? @db.Decimal(14, 2)

  @@map("borrower_income_details")
}

model BorrowerGovernmentId {
  id         String   @id @default(uuid())
  borrowerId String   @unique
  borrower   Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  sssNumber  String?
  tinNumber  String?

  @@map("borrower_government_ids")
}

/// Philippine Standard Geographic Code reference data — read-only lookup tables imported from the
/// legacy `db-address-api` Mongo dump (scripts/import-psgc-reference-data.ts). Used to decode the
/// raw PSGC codes some legacy borrower addresses were stored as (see scripts/fix-coded-addresses.ts)
/// and, going forward, to back a real cascading Region -> Province -> City/Municipality -> Barangay
/// picker instead of free-text entry.
model PsgcRegion {
  code      String         @id
  name      String
  provinces PsgcProvince[]

  @@map("psgc_regions")
}

model PsgcProvince {
  code       String                 @id
  name       String
  regionCode String
  region     PsgcRegion             @relation(fields: [regionCode], references: [code])
  cities     PsgcCityMunicipality[]

  @@index([regionCode])
  @@map("psgc_provinces")
}

model PsgcCityMunicipality {
  code         String         @id
  name         String
  provinceCode String
  province     PsgcProvince   @relation(fields: [provinceCode], references: [code])
  barangays    PsgcBarangay[]
  /// 2026-07-14: backfilled from a third-party reference list (see
  /// scripts/import-ph-zip-codes.ts's own doc comment for source/license/caveats) - null where no
  /// confident name match was found, never guessed. Used to auto-fill the address picker's ZIP
  /// Code field once a city/municipality is selected (still a plain editable Input afterward -
  /// staff can correct it, e.g. for a city that spans multiple ZIP codes).
  zipCode      String?

  @@index([provinceCode])
  @@map("psgc_city_municipalities")
}

model PsgcBarangay {
  code                 String               @id
  name                 String
  cityMunicipalityCode String
  /// Best-effort suggestion only (see scripts/import-ph-zip-codes.ts) - populated for NCR, where a
  /// single city has multiple ZIP codes depending on barangay (e.g. Makati). Null everywhere a
  /// single city-level ZIP already covers the area (PsgcCityMunicipality.zipCode).
  zipCode              String?
  cityMunicipality     PsgcCityMunicipality @relation(fields: [cityMunicipalityCode], references: [code])

  @@index([cityMunicipalityCode])
  @@map("psgc_barangays")
}

/// ADR-014: polymorphic owner (Borrower or Co-Borrower) — a direct sample
/// cross-reference during Phase 0 exploration showed an address attached
/// to a Co-Borrower's own ID, not only to a Borrower.
model Address {
  id                 String           @id @default(uuid())
  ownerType          AddressOwnerType
  ownerId            String
  addressType        String?
  houseUnitNumber    String?
  street             String?
  barangay           String?
  cityMunicipality   String?
  province           String?
  zipCode            String?
  lengthOfStayMonths Int?
  ownershipStatus    String?

  createdAt DateTime @default(now())

  @@index([ownerType, ownerId])
  @@map("addresses")
}

model IdentificationDocument {
  id               String    @id @default(uuid())
  borrowerId       String
  borrower         Borrower  @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  documentType     String
  documentNumber   String
  issuingAuthority String?
  validUntil       DateTime?

  /// Schema Review SR-09: supports search by Government ID (PROJECT_RULES.md §Search).
  @@index([documentNumber])
  @@map("identification_documents")
}

/// ADR-013: optional by default (only 54 of 4,629 legacy clients had one).
model CharacterReference {
  id           String   @id @default(uuid())
  borrowerId   String
  borrower     Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  relationship String?
  phoneNumber  String?
  emailAddress String?

  @@map("character_references")
}

/// ADR-015 RESOLVED (2026-07-16, user decision): per-Borrower, not per-LoanAccount. The legacy
/// sdev system's own `co_borrowers.parent_key` already resolved to the CLIENT, not a specific
/// loan (see migrate-legacy-data.ts's Phase 3 comment) — every one of that period's co-borrowers
/// was attached to every one of that client's loans as a practical migration-time default, which
/// this resolution now makes the modeled behavior instead of a workaround. `borrowerId` is
/// nullable only because 1 already-migrated CoBorrower (of 217) has no loan-account link at all to
/// derive it from — see the backfill script for that one row's disposition. `LoanAccountCoBorrower`
/// is kept as-is (historical per-loan attachment record, still accurate), just no longer the
/// primary way a co-borrower is associated with a client going forward.
model CoBorrower {
  id           String    @id @default(uuid())
  borrowerId   String?
  borrower     Borrower? @relation(fields: [borrowerId], references: [id])
  firstName    String
  middleName   String?
  lastName     String
  gender       String?
  civilStatus  String?
  birthDate    DateTime?
  phoneNumber  String?
  emailAddress String?
  relationship String?
  employer     String?

  legacyId String? @unique

  loanAccounts    LoanAccountCoBorrower[]
  signingSessions LoanSigningSession[]

  @@index([borrowerId])
  @@map("co_borrowers")
}

model LoanAccountCoBorrower {
  loanAccountId String
  coBorrowerId  String
  loanAccount   LoanAccount @relation(fields: [loanAccountId], references: [id], onDelete: Cascade)
  coBorrower    CoBorrower  @relation(fields: [coBorrowerId], references: [id], onDelete: Cascade)

  @@id([loanAccountId, coBorrowerId])
  @@map("loan_account_co_borrowers")
}

// ----------------------------------------------------------------------------
// Loan Account & Ledger — LA-1..5, TXN-1..4, REPAY-1..4
// ADR-007: no stored `outstandingBalance` column — computed in the domain
// layer from components; single point of change once the formula is
// confirmed.
// ADR-010 (Critical/compliance): addOn/contractual interest columns exist,
// no derivation or disclosure logic until resolved.
// ADR-004 (PENDING, intentionally deferred): legacy `loan_accounts` has an
// `accountHolderType` that can be GROUP as well as CLIENT/individual. This
// schema intentionally supports individual Borrower-held loans only —
// `LoanAccount.borrowerId` is a required FK to `Borrower`, with no Group
// entity or polymorphic account-holder concept. This is a deliberate,
// tracked scope limit for Phase 1, not an oversight (see Schema Review
// SR-01); introducing Group-held loans is out of scope for this migration
// and requires ADR-004 to be resolved and a dedicated design pass first.
// ADR-032 (PENDING, working assumption only): "Loan Release" vs.
// "Disbursement" — whether these are one event or two — is unresolved.
// This schema takes the position that they are two distinct moments:
// `LoanAccount.activatedAt` represents the loan being released/booked,
// while the `DISBURSEMENT`-typed `LoanTransaction.entryDate` represents
// the actual funds-disbursement event. This is a working assumption, not
// a resolution of ADR-032 — revisit both fields' semantics once ADR-032
// is formally decided.
// ----------------------------------------------------------------------------

model LoanAccount {
  id                   String             @id @default(uuid())
  loanCode             String             @unique
  borrowerId           String
  borrower             Borrower           @relation(fields: [borrowerId], references: [id])
  loanProductVersionId String
  loanProductVersion   LoanProductVersion @relation(fields: [loanProductVersionId], references: [id])
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id])
  loanOfficerId        String?
  loanOfficer          User?              @relation("LoanAccountOfficer", fields: [loanOfficerId], references: [id])

  status LoanAccountStatus @default(PENDING_APPROVAL)

  principalAmount  Decimal @db.Decimal(14, 2)
  principalBalance Decimal @default(0) @db.Decimal(14, 2)
  principalPaid    Decimal @default(0) @db.Decimal(14, 2)
  principalDue     Decimal @default(0) @db.Decimal(14, 2)

  /// Snapshot at approval — LA-4. Never recomputed from a later product edit.
  interestRate            Decimal  @db.Decimal(6, 3)
  addOnInterestRate       Decimal? @db.Decimal(6, 3)
  contractualInterestRate Decimal? @db.Decimal(6, 3)
  interestBalance         Decimal  @default(0) @db.Decimal(14, 2)
  interestPaid            Decimal  @default(0) @db.Decimal(14, 2)
  interestDue             Decimal  @default(0) @db.Decimal(14, 2)

  feesBalance Decimal @default(0) @db.Decimal(14, 2)
  feesPaid    Decimal @default(0) @db.Decimal(14, 2)
  feesDue     Decimal @default(0) @db.Decimal(14, 2)

  penaltyBalance Decimal @default(0) @db.Decimal(14, 2)
  penaltyPaid    Decimal @default(0) @db.Decimal(14, 2)
  penaltyDue     Decimal @default(0) @db.Decimal(14, 2)

  installmentCount    Int
  repaymentPeriodUnit RepaymentPeriodUnit @default(MONTHS)
  gracePeriodDays     Int                 @default(0)

  /// ADR-045 (Concept 1 — Exact First Repayment Date): an explicit input
  /// supplied at origination, never computed/derived from disbursement
  /// date or any other field — no recoverable generation rule exists in
  /// this system's evidence base (see ADR-045 §1-§3). Used as the anchor
  /// date for RepaymentInstallment schedule generation at activation
  /// (Milestone 9.1 checkpoint 8); subsequent installments are spaced from
  /// this date by repaymentPeriodUnit.
  firstRepaymentDate DateTime

  /// 2026-07-14 (Promissory Note "Anticipated Disbursement Date"): staff-entered estimate
  /// captured on the Create Loan Account form, used there to compute the Advance Interest Fee
  /// (ADR-046) but previously discarded rather than persisted. Now stored so it can be reused as
  /// the `{AnticipatedDisbursementDate}` merge field on generated loan documents (ADR-051).
  /// Distinct from `activatedAt`, which is the real disbursement date, only known once the loan is
  /// actually activated/released — this field exists precisely because documents are generated at
  /// APPROVED, before `activatedAt` has a value.
  anticipatedDisbursementDate DateTime?

  approvedAt       DateTime?
  approvedByUserId String?
  approvedBy       User?     @relation("LoanAccountApprovedBy", fields: [approvedByUserId], references: [id])
  activatedAt      DateTime?
  closedAt         DateTime?
  closedReason     String?

  /// 2026-07-16: set at "Create Loan Account" time to the LoanApplication this account was
  /// actually produced from — mirrors Borrower.sourceApplicationId's identical pattern. Replaces
  /// a previous heuristic (loanApplicationController.buildLinkage: "this borrower's most
  /// recent/first loan account") that falsely showed an unrelated older loan account — e.g. a
  /// closed prior loan — as "the account this newly-approved application produced" for any
  /// borrower who already had a loan account on file (a renewal's exact scenario). Null for
  /// every loan account created before this field existed and for legacy-migrated accounts.
  sourceApplicationId String?          @unique
  sourceApplication   LoanApplication? @relation("LoanApplicationCreatedLoanAccount", fields: [sourceApplicationId], references: [id])

  /// CP12 migration follow-up (2026-07-09): true for a loan whose legacy record had NO
  /// account-level balance snapshot fields at all (principalBalance/interestBalance/feesBalance/
  /// penaltyBalance all absent, not zero) — 624 of 1,805 migrated loans, 191 of them
  /// Active/ActiveInArrears. All balance columns on those rows were migrated as 0.00 for lack of
  /// any other value, which would misleadingly read as "fully settled" — this flag exists so
  /// staff can tell "genuinely zero" apart from "balance unknown, needs manual reconciliation".
  /// Never set for a loan created going forward through this system's own
  /// ActivateLoanUseCase/ProcessPaymentUseCase, which always populate real balances.
  legacyBalanceDataMissing Boolean @default(false)

  /// ADR-007 §4 (2026-07-08 decision, "Option A"): true for exactly the 79 legacy `CLOSED` loans
  /// whose migrated balance columns (principal+interest+fees+penalty) don't sum to zero, despite
  /// being marked fully settled - migrated as-is per that decision (never fabricated a corrected
  /// figure), flagged here so accounting can manually review each one individually. Backfilled
  /// once by scripts/flag-non-reconciling-closed-loans.ts (2026-07-23) - never set for a loan
  /// created going forward through this system's own use cases, same posture as
  /// legacyBalanceDataMissing above (mutually exclusive: that flag is for accounts with NO balance
  /// snapshot at all, this one is for accounts with a present-but-non-zero balance on a closed loan).
  legacyNonReconcilingClosedBalance Boolean @default(false)

  /// 2026-07-11 (Create Loan Account, origination fees): one-time deductions taken at
  /// disbursement — distinct from feesBalance/feesPaid/feesDue above, which track recurring
  /// per-installment fees. Staff-entered amounts, not auto-computed from a fixed formula, per
  /// `docs/Architecture/LEGACY_EXCEL_LMS_REFERENCE.md` — real data (Loans_details, BETA 1.5.83
  /// LMSv3.xlsm) shows most of these vary too much per loan to derive a reliable per-product
  /// formula (confirmed: only Account Management Fee at exactly 1% of principal when charged).
  /// advanceInterestFee's real formula IS confirmed separately (ADR-046) but is still captured
  /// here as a plain entered amount, not recomputed by this schema.
  processingFee            Decimal @default(0) @db.Decimal(14, 2)
  advanceInterestFee       Decimal @default(0) @db.Decimal(14, 2)
  /// Previous loan's remaining balance, paid off from this loan's proceeds — the renewal case.
  outstandingBalancePayoff Decimal @default(0) @db.Decimal(14, 2)
  docStampFee              Decimal @default(0) @db.Decimal(14, 2)
  accountManagementFee     Decimal @default(0) @db.Decimal(14, 2)
  otherFees                Decimal @default(0) @db.Decimal(14, 2)
  notarialFee              Decimal @default(0) @db.Decimal(14, 2)
  webFee                   Decimal @default(0) @db.Decimal(14, 2)
  insuranceFee             Decimal @default(0) @db.Decimal(14, 2)
  /// = principalAmount - (sum of the 9 fee/payoff fields above). Computed once at creation, never
  /// recomputed later — matches every other origination snapshot field's LA-4 treatment.
  netProceeds              Decimal @default(0) @db.Decimal(14, 2)

  legacyId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ADR-048-optimistic-concurrency: optimistic concurrency control for every
  /// balance-mutating write. Every conditional update increments this and
  /// checks it in the same `WHERE` clause; a zero-row result means another
  /// writer moved first, and the caller must receive a
  /// `ConcurrencyConflictError`, never a silent overwrite.
  version Int @default(0)

  transactions                 LoanTransaction[]
  repaymentSchedule            RepaymentSchedule[]
  appliedFees                  AppliedFee[]
  coBorrowers                  LoanAccountCoBorrower[]
  notes                        LoanNote[]
  generatedDocuments           GeneratedLoanDocument[]
  smsReminderLogs              SmsReminderLog[]
  emailReminderLogs            EmailReminderLog[]
  generatedStatementsOfAccount GeneratedStatementOfAccount[]
  loanSigningSessions          LoanSigningSession[]
  signingNotificationLogs      SigningNotificationLog[]
  /// 2026-07-24 (Loan Restructure) — set on the OLD account when it was closed via restructure.
  restructuredFromRecord       LoanRestructure?              @relation("OldLoanRestructure")
  /// 2026-07-24 (Loan Restructure) — set on the NEW account created by a restructure.
  restructuredIntoRecord       LoanRestructure?              @relation("NewLoanRestructure")
  /// 2026-07-24 (Loan Adjustment) — set on the OLD account when it was closed via adjustment.
  adjustedFromRecord           LoanAdjustment?               @relation("OldLoanAdjustment")
  /// 2026-07-24 (Loan Adjustment) — set on the NEW account created by an adjustment.
  adjustedIntoRecord           LoanAdjustment?               @relation("NewLoanAdjustment")

  /// Schema Review SR-10: branch dashboards and Loan Officer Performance
  /// reports (PROJECT_RULES.md §Reports) were previously unindexed.
  @@index([borrowerId])
  @@index([status])
  @@index([branchId])
  @@index([loanOfficerId])
  @@map("loan_accounts")
}

/// TXN-1: append-only. Corrections are new, explicitly linked reversal
/// transactions — never edits or deletes of an existing row.
model LoanTransaction {
  id            String              @id @default(uuid())
  loanAccountId String
  loanAccount   LoanAccount         @relation(fields: [loanAccountId], references: [id])
  type          LoanTransactionType

  amount             Decimal @db.Decimal(14, 2)
  principalComponent Decimal @default(0) @db.Decimal(14, 2)
  interestComponent  Decimal @default(0) @db.Decimal(14, 2)
  feesComponent      Decimal @default(0) @db.Decimal(14, 2)
  penaltyComponent   Decimal @default(0) @db.Decimal(14, 2)
  balanceAfter       Decimal @db.Decimal(14, 2)

  postedByUserId String?
  postedBy       User?    @relation("LoanTransactionPostedBy", fields: [postedByUserId], references: [id])
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id])
  entryDate      DateTime
  comment        String?

  /// Official Receipt number — required on every REPAYMENT posted through
  /// Payment Recording (2026-07-11 user request), matching the SDevTech
  /// system's own OR#/AR# fields (also independently found in MIS Nomer's
  /// own Excel LMS's Payment_History sheet — see
  /// docs/Architecture/LEGACY_EXCEL_LMS_REFERENCE.md §3.1). Nullable at the
  /// schema level because non-REPAYMENT transaction types (DISBURSEMENT,
  /// ADJUSTMENT, etc.) have no receipt to record — requiredness for
  /// REPAYMENT specifically is enforced by processPaymentSchema, not here.
  orNumber      String?
  /// Acknowledgment Receipt number — optional; not every payment channel
  /// issues one.
  arNumber      String?
  /// 2026-07-17 (Reports): the "Mode of Payment" selected on Record Payment (GCash/Cash/Bank
  /// Transfer/PDC/Auto Debit — see `ACTIVE_PAYMENT_METHODS` in frontend `staticConfig.ts`), one
  /// of the stored raw `code` values. Previously captured in the UI but silently discarded -
  /// needed for the Daily Collection Report's "Channel" column. Nullable: historical/migrated
  /// transactions and non-REPAYMENT types have no channel.
  paymentMethod String?

  /// Present on a transaction that IS a reversal — points to the original
  /// transaction it corrects (TXN-1).
  reversesTransactionId String?          @unique
  reversesTransaction   LoanTransaction? @relation("LoanTransactionReversal", fields: [reversesTransactionId], references: [id])
  reversedByTransaction LoanTransaction? @relation("LoanTransactionReversal")

  legacyId  String?  @unique
  createdAt DateTime @default(now())

  appliedFees        AppliedFee[]
  /// 2026-07-11 (Reverse Payment): per-installment breakdown of this
  /// transaction's effect — see `PaymentAllocation`'s own doc comment for
  /// why this exists. Present on REPAYMENT (and, going forward, REVERSAL)
  /// transactions; empty for every other type.
  paymentAllocations PaymentAllocation[]
  /// 2026-08-14 (Manual Payment Adjustment feature) — see `PaymentAdjustment`'s own doc comment.
  /// Only ever present on a legacy REPAYMENT transaction (one with no `PaymentAllocation` rows,
  /// i.e. one `ReversePaymentUseCase` refuses to touch) that was corrected through this tool
  /// instead.
  paymentAdjustments PaymentAdjustment[]
  /// 2026-08-15 (Add Fee feature) — see `FeeCharge`'s own doc comment. Present on a `FEE_CHARGED`
  /// transaction created through this tool; empty for a migrated FEE_CHARGED row (no `FeeCharge`
  /// backfilled for legacy data, same "written going forward only" posture as `PaymentAllocation`).
  feeCharges         FeeCharge[]
  /// 2026-08-19 (Add Penalty feature) — see `PenaltyCharge`'s own doc comment. Present on a
  /// `PENALTY_APPLIED` transaction created through this tool; empty for a migrated row, same
  /// "written going forward only" posture as `feeCharges`.
  penaltyCharges     PenaltyCharge[]

  /// Schema Review SR-11 (Critical): `loan_transactions` is the highest-
  /// volume table (legacy equivalent: 524k rows) — date-range and
  /// officer/branch-filtered transaction reports were previously unindexed.
  @@index([loanAccountId])
  @@index([type])
  @@index([entryDate])
  @@index([postedByUserId])
  @@index([branchId])
  /// 2026-08-17 (perf fix): `listDistinctChannels()` (Transaction Report's channel filter dropdown,
  /// called on every page load) did `SELECT DISTINCT "paymentMethod" WHERE "paymentMethod" IS NOT
  /// NULL` with no supporting index — a full parallel seq scan over ~280k rows, ~1s measured. This
  /// index turns that into an index-only scan.
  @@index([paymentMethod])
  @@map("loan_transactions")
}

/// CP12 follow-up (2026-07-23, user request): permanent record of the 244,242 legacy
/// `loan_transactions` rows (46.5% of the 524,724-row legacy ledger) whose `parent_account_key`
/// matches no row in the legacy `loan_accounts` export - confirmed via scripts/
/// analyze-orphaned-transactions.ts to be a genuine legacy data gap (the referenced accounts don't
/// exist anywhere in the legacy dump, not merely excluded by migration scope - see
/// docs/Architecture/CP12-legacy-migration-report.md's "Known gaps" section). These can never be
/// linked to a `LoanAccount` (there is no account to link to), so they live in their own table
/// instead of `LoanTransaction` - imported once by scripts/export-orphaned-transactions.ts so the
/// raw data survives even though the legacy `legacy/mongodb/` dump itself is gitignored and was
/// briefly lost once already before this table existed.
model LegacyOrphanedTransaction {
  id                  String    @id @default(uuid())
  /// The legacy transaction's own `uid`/`_id` - unique per source row, used as the idempotency key
  /// for re-running the export script.
  legacyTransactionId String    @unique
  /// The legacy `parent_account_key` this transaction pointed to - confirmed to match no
  /// `LoanAccount.legacyId` and no row in the legacy loan_accounts export at all.
  parentAccountKey    String
  legacyType          String?
  amount              Decimal?  @db.Decimal(14, 2)
  entryDate           DateTime?
  comment             String?
  /// The full original BSON document, converted to JSON - nothing explicitly mapped above is ever
  /// the only copy of a field; anything not surfaced as its own column is still recoverable here.
  rawDocument         Json
  importedAt          DateTime  @default(now())

  @@index([parentAccountKey])
  @@map("legacy_orphaned_transactions")
}

/// REPAY-1..4. Note: legacy tax_* / organization-commission / funders-interest
/// fields are intentionally dropped (ADR-028: consistently zero across all
/// sampled legacy records — YAGNI; can be reintroduced if a genuine
/// multi-funder/tax feature is confirmed later).
model RepaymentSchedule {
  id                String      @id @default(uuid())
  loanAccountId     String
  loanAccount       LoanAccount @relation(fields: [loanAccountId], references: [id])
  installmentNumber Int
  dueDate           DateTime

  principalDue  Decimal @default(0) @db.Decimal(14, 2)
  interestDue   Decimal @default(0) @db.Decimal(14, 2)
  feesDue       Decimal @default(0) @db.Decimal(14, 2)
  penaltyDue    Decimal @default(0) @db.Decimal(14, 2)
  principalPaid Decimal @default(0) @db.Decimal(14, 2)
  interestPaid  Decimal @default(0) @db.Decimal(14, 2)
  feesPaid      Decimal @default(0) @db.Decimal(14, 2)
  penaltyPaid   Decimal @default(0) @db.Decimal(14, 2)

  status     RepaymentInstallmentStatus @default(PENDING)
  lastPaidAt DateTime?

  legacyId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 2026-07-15 (Reduce Penalty feature, user-confirmed business rule): an Accounting/MIS-set
  /// manual override that FREEZES this installment's penalty at the given amount — once set, it
  /// replaces ADR-050's live daily computation entirely (no longer grows day over day) until paid
  /// or overridden again. Null = no override, normal computation applies (live for a prospective
  /// loan, the migrated `penaltyDue` snapshot otherwise). Deliberately NOT a mutation of the
  /// immutable `penaltyDue`/`penaltyPaid` fields above (REPAY-3) — a separate override layer, kept
  /// alongside an immutable `PenaltyReduction` audit row per action for full history even across
  /// repeated reductions.
  penaltyOverrideAmount   Decimal?  @db.Decimal(14, 2)
  penaltyOverrideReason   String?
  penaltyOverrideByUserId String?
  penaltyOverrideBy       User?     @relation("PenaltyOverrideBy", fields: [penaltyOverrideByUserId], references: [id])
  penaltyOverrideAt       DateTime?

  /// 2026-07-15 (Adjust Fees feature, user-confirmed business rules): an Accounting/MIS-set manual
  /// override on this installment's fees due — unlike the penalty override above, fees are never
  /// live-computed (no daily formula to "freeze" against), so this simply replaces the effective
  /// fees-due figure until paid or adjusted again. Bidirectional (may raise or lower the amount,
  /// per the user's explicit decision — unlike the penalty override, which may only lower).
  /// Deliberately NOT a mutation of the immutable `feesDue`/`feesPaid` fields above (REPAY-3) — a
  /// separate override layer, kept alongside an immutable `FeeAdjustment` audit row per action.
  feesOverrideAmount   Decimal?  @db.Decimal(14, 2)
  feesOverrideReason   String?
  feesOverrideByUserId String?
  feesOverrideBy       User?     @relation("FeesOverrideBy", fields: [feesOverrideByUserId], references: [id])
  feesOverrideAt       DateTime?

  /// ADR-048-optimistic-concurrency: same optimistic concurrency mechanism as
  /// `LoanAccount.version` — see that field's comment for the full
  /// rationale. Applied here too for consistency, per the ADR's decision
  /// to scope this to every balance-mutating aggregate, not just one.
  version Int @default(0)

  paymentAllocations PaymentAllocation[]
  paymentAdjustments PaymentAdjustment[]
  penaltyReductions  PenaltyReduction[]
  feeAdjustments     FeeAdjustment[]
  feeCharges         FeeCharge[]
  penaltyCharges     PenaltyCharge[]
  smsReminderLogs    SmsReminderLog[]
  emailReminderLogs  EmailReminderLog[]

  /// Schema Review SR-12 (Critical): Aging, Delinquency, Expected
  /// Collection, and Daily Collection reports (PROJECT_RULES.md §Reports)
  /// all filter on due date and status — previously unindexed beyond
  /// (loanAccountId, installmentNumber).
  @@unique([loanAccountId, installmentNumber])
  @@index([dueDate])
  @@index([status])
  @@map("repayment_schedules")
}

/// 2026-07-15 (Reduce Penalty feature): one immutable row per reduction action — like
/// `PaymentAllocation`/`AppliedFee`, a historical record, never edited. Preserves the full history
/// even when the same installment is reduced more than once (`RepaymentSchedule.penaltyOverride*`
/// only tracks the CURRENT/latest override).
model PenaltyReduction {
  id                     String            @id @default(uuid())
  repaymentInstallmentId String
  repaymentInstallment   RepaymentSchedule @relation(fields: [repaymentInstallmentId], references: [id])

  /// What the penalty would have been (live-computed, or the migrated snapshot) at the moment of
  /// this action — not necessarily the previous override, since this may be the first reduction.
  previousPenaltyAmount Decimal @db.Decimal(14, 2)
  newPenaltyAmount      Decimal @db.Decimal(14, 2)

  /// Required — captures the external approval reference (business rule: reductions are approved
  /// outside this system, e.g. a branch manager memo; this system records the reference, not a
  /// second in-app approval workflow).
  reason String

  reducedByUserId String
  reducedBy       User     @relation(fields: [reducedByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@index([repaymentInstallmentId])
  @@map("penalty_reductions")
}

/// 2026-07-24 (Loan Restructure feature, user-confirmed): one immutable row per restructure
/// action — same "historical record, never edited" posture as PenaltyReduction/FeeAdjustment.
/// A loan account may be the OLD side of at most one restructure ever (@@unique on
/// oldLoanAccountId — "isang beses lang pwede gawin per loan account"), but the resulting NEW
/// account is an ordinary loan account and may itself be restructured again later if it too
/// falls past due/matured.
model LoanRestructure {
  id String @id @default(uuid())

  /// 2026-08-08 (Undo Restructure feature, user-confirmed revision): `@unique` again - a reverted
  /// restructure now deletes this row outright (see UndoRestructureLoanUseCase), so at most one
  /// row can ever exist per old loan account at a time; a fresh restructure after an undo simply
  /// creates a new row once the old one is gone.
  oldLoanAccountId String      @unique
  oldLoanAccount   LoanAccount @relation("OldLoanRestructure", fields: [oldLoanAccountId], references: [id])
  newLoanAccountId String      @unique
  newLoanAccount   LoanAccount @relation("NewLoanRestructure", fields: [newLoanAccountId], references: [id])

  /// The old loan's full Collections Balance (principal + interest + fees + penalty) at the
  /// moment of restructure — user-confirmed to become the new loan's entire principal amount,
  /// carried here as a snapshot since the old account's own balance columns are frozen as of
  /// closedAt and shouldn't be re-read to explain a historical restructure later.
  previousCollectionsBalance Decimal @db.Decimal(14, 2)
  /// = previousCollectionsBalance at creation (LA-4-style snapshot) — kept as its own column
  /// rather than re-deriving from the new loan's principalAmount, which could theoretically be
  /// edited later while PENDING_APPROVAL (not applicable here since restructure activates the
  /// new loan directly, but keeping this as an explicit snapshot avoids relying on that).
  newPrincipalAmount         Decimal @db.Decimal(14, 2)

  reason String?

  restructuredByUserId String
  restructuredBy       User     @relation("LoanRestructureBy", fields: [restructuredByUserId], references: [id])
  createdAt            DateTime @default(now())

  @@map("loan_restructures")
}

/// 2026-07-24 (Loan Adjustment feature, user-confirmed): one immutable row per adjustment action —
/// same "historical record, never edited" posture as LoanRestructure. Unlike LoanRestructure, no
/// balance/principal fields at all - only the schedule's due dates change (same principal, rate,
/// term, product copied verbatim onto the new account). A loan account may be the OLD side of at
/// most one adjustment ever (@@unique on oldLoanAccountId).
model LoanAdjustment {
  id String @id @default(uuid())

  /// 2026-08-08 (Undo Adjustment feature, user-confirmed revision): same "@unique again, row
  /// deleted outright on undo" change as LoanRestructure.oldLoanAccountId, for the same reason.
  oldLoanAccountId String      @unique
  oldLoanAccount   LoanAccount @relation("OldLoanAdjustment", fields: [oldLoanAccountId], references: [id])
  newLoanAccountId String      @unique
  newLoanAccount   LoanAccount @relation("NewLoanAdjustment", fields: [newLoanAccountId], references: [id])

  previousFirstRepaymentDate DateTime
  newFirstRepaymentDate      DateTime

  reason String?

  adjustedByUserId String
  adjustedBy       User     @relation("LoanAdjustmentBy", fields: [adjustedByUserId], references: [id])
  createdAt        DateTime @default(now())

  @@map("loan_adjustments")
}

/// 2026-07-15 (Adjust Fees feature) — one immutable row per adjustment action, same posture as
/// `PenaltyReduction`: a historical record, never edited. Bidirectional (unlike
/// `PenaltyReduction`, `newFeesAmount` may be higher OR lower than `previousFeesAmount`).
model FeeAdjustment {
  id                     String            @id @default(uuid())
  repaymentInstallmentId String
  repaymentInstallment   RepaymentSchedule @relation(fields: [repaymentInstallmentId], references: [id])

  /// The effective fees due (override if one was already set, else the immutable `feesDue`
  /// snapshot) at the moment of this action — not necessarily the previous override, since this
  /// may be the first adjustment.
  previousFeesAmount Decimal @db.Decimal(14, 2)
  newFeesAmount      Decimal @db.Decimal(14, 2)

  /// Required — captures the external approval reference, same convention as `PenaltyReduction.reason`.
  reason String

  adjustedByUserId String
  adjustedBy       User     @relation(fields: [adjustedByUserId], references: [id])
  createdAt        DateTime @default(now())

  @@index([repaymentInstallmentId])
  @@map("fee_adjustments")
}

/// 2026-08-15 (Add Fee feature, user-confirmed): a genuinely NEW fee charge (e.g. a late fee),
/// distinct from `FeeAdjustment` above — that tool corrects an already-recorded amount
/// (correction semantics, no ledger transaction), this one imposes an additional obligation that
/// didn't exist before (charge semantics, creates a real `FEE_CHARGED` `LoanTransaction` — see
/// `AddFeeUseCase`'s own doc comment for why the distinction matters and mirrors SDevTech's own
/// FEE_CHARGED vs adjustment-type event split). Same "immutable historical record, never edited"
/// posture as `PenaltyReduction`/`FeeAdjustment`. Bidirectional-looking shape (previous/new) for
/// consistency with those two, but in practice `newFeesAmount` is always `previousFeesAmount +
/// the charged amount` — a charge only ever adds.
model FeeCharge {
  id                     String            @id @default(uuid())
  repaymentInstallmentId String
  repaymentInstallment   RepaymentSchedule @relation(fields: [repaymentInstallmentId], references: [id])
  loanTransactionId      String
  loanTransaction        LoanTransaction   @relation(fields: [loanTransactionId], references: [id])

  /// The effective fees due (override if one was already set, else the immutable `feesDue`
  /// snapshot) immediately before this charge.
  previousFeesAmount Decimal @db.Decimal(14, 2)
  newFeesAmount      Decimal @db.Decimal(14, 2)

  /// Required — what this fee is for (e.g. "Late payment fee, memo #..."), same convention as
  /// `PenaltyReduction.reason`/`FeeAdjustment.reason`.
  reason String

  chargedByUserId String
  chargedBy       User     @relation(fields: [chargedByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@index([repaymentInstallmentId])
  @@index([loanTransactionId])
  @@map("fee_charges")
}

/// 2026-08-19 (Add Penalty feature) — mirrors FeeCharge exactly, but for penalty. Built for the
/// migration period: with the live ADR-050 auto-computation disabled
/// (PENALTY_AUTO_COMPUTE_ENABLED=false, see CurrentPenaltyResolver.ts), staff manually key in
/// whatever penalty SDevTech's own screen shows via this action, one immutable row per charge —
/// same "historical record, never edited" posture as PenaltyReduction/FeeCharge.
model PenaltyCharge {
  id                     String            @id @default(uuid())
  repaymentInstallmentId String
  repaymentInstallment   RepaymentSchedule @relation(fields: [repaymentInstallmentId], references: [id])
  loanTransactionId      String
  loanTransaction        LoanTransaction   @relation(fields: [loanTransactionId], references: [id])

  /// The effective penalty due (override if one was already set, else the immutable/computed
  /// `due.penalty`) immediately before this charge.
  previousPenaltyAmount Decimal @db.Decimal(14, 2)
  newPenaltyAmount      Decimal @db.Decimal(14, 2)

  /// Required — what this penalty is for (e.g. "Per SDevTech screen as of 2026-08-19"), same
  /// convention as PenaltyReduction.reason/FeeCharge.reason.
  reason String

  chargedByUserId String
  chargedBy       User     @relation(fields: [chargedByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@index([repaymentInstallmentId])
  @@index([loanTransactionId])
  @@map("penalty_charges")
}

/// 2026-07-11 (Reverse Payment feature). `ProcessPaymentUseCase` applies one
/// payment across possibly several installments (`ADR-009`'s waterfall, or a
/// staff-entered manual split) but only ever persisted the AGGREGATE
/// principal/interest/fees/penalty totals on the resulting `LoanTransaction`
/// — no record existed of exactly which installment(s), and how much of
/// each component, that one transaction actually touched. That's fine for
/// display, but not enough to safely reverse a specific past payment later
/// (undoing the wrong installment, or the wrong amount, would itself be a
/// financial error) — especially once other payments have touched the same
/// loan afterward. This table closes that gap: one row per
/// (transaction, installment) pair a REPAYMENT transaction affected, with
/// the exact per-component amounts applied. `ReversePaymentUseCase` reads
/// these rows back to know precisely what to undo, per installment, then
/// negates them via the same `RepaymentInstallment.recordPayment()` /
/// `LoanAccount.applyPayment()` primitives `ProcessPaymentUseCase` itself
/// uses (Money/InstallmentAmounts/TransactionComponents already support
/// negative amounts — see `Money`'s own doc comment). Written going forward
/// only; not backfilled for transactions recorded before this feature
/// existed — those remain reversible only by the older, coarser workaround
/// (a manual ADJUSTMENT transaction), same as before this feature.
model PaymentAllocation {
  id                     String            @id @default(uuid())
  loanTransactionId      String
  loanTransaction        LoanTransaction   @relation(fields: [loanTransactionId], references: [id])
  repaymentInstallmentId String
  repaymentInstallment   RepaymentSchedule @relation(fields: [repaymentInstallmentId], references: [id])

  principalApplied Decimal @default(0) @db.Decimal(14, 2)
  interestApplied  Decimal @default(0) @db.Decimal(14, 2)
  feesApplied      Decimal @default(0) @db.Decimal(14, 2)
  penaltyApplied   Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([loanTransactionId])
  @@index([repaymentInstallmentId])
  @@map("payment_allocations")
}

/// 2026-08-14 (Manual Payment Adjustment feature) — the "manual adjustment" the
/// `NoReversibleAllocationDataError` message points to, which didn't exist until now. Covers
/// exactly the gap `PaymentAllocation` above describes: a legacy REPAYMENT transaction recorded
/// before that feature existed has no per-installment breakdown, so `ReversePaymentUseCase` can't
/// safely undo it automatically. This tool instead lets MIS staff pick a specific installment and
/// manually reduce its recorded paid amounts by an explicit, reasoned delta — one row per
/// (transaction, installment) touched, same "immutable historical record" posture as
/// `PenaltyReduction`/`FeeAdjustment`. `loanTransactionId` links back to the original payment being
/// corrected purely for traceability (so the transaction's own history shows it was later
/// corrected); the actual balance/installment mutation happens the same way
/// `ReversePaymentUseCase` does it (negated `RepaymentInstallment.recordPayment()` /
/// `LoanAccount.applyPayment()`), just with staff-specified amounts instead of amounts read back
/// from `PaymentAllocation` rows that don't exist for this transaction.
model PaymentAdjustment {
  id                     String            @id @default(uuid())
  loanTransactionId      String
  loanTransaction        LoanTransaction   @relation(fields: [loanTransactionId], references: [id])
  repaymentInstallmentId String
  repaymentInstallment   RepaymentSchedule @relation(fields: [repaymentInstallmentId], references: [id])

  /// The installment's own `principal/interest/fees/penaltyPaid` immediately before this action.
  previousPrincipalPaid Decimal @db.Decimal(14, 2)
  previousInterestPaid  Decimal @db.Decimal(14, 2)
  previousFeesPaid      Decimal @db.Decimal(14, 2)
  previousPenaltyPaid   Decimal @db.Decimal(14, 2)

  newPrincipalPaid Decimal @db.Decimal(14, 2)
  newInterestPaid  Decimal @db.Decimal(14, 2)
  newFeesPaid      Decimal @db.Decimal(14, 2)
  newPenaltyPaid   Decimal @db.Decimal(14, 2)

  /// Required — same convention as `PenaltyReduction.reason`/`FeeAdjustment.reason`: captures why
  /// this correction was made (e.g. "duplicate encoding, verified against OR #12345").
  reason String

  adjustedByUserId String
  adjustedBy       User     @relation(fields: [adjustedByUserId], references: [id])
  createdAt        DateTime @default(now())

  @@index([loanTransactionId])
  @@index([repaymentInstallmentId])
  @@map("payment_adjustments")
}

/// 2026-07-11 (user request, Collections use case): a free-text note tied to a loan account —
/// e.g. what was discussed/agreed with the borrower during a collection call. Deliberately simple
/// (just text + author + timestamp, no structured fields like contact method or outcome code) per
/// explicit user decision — flexibility over structure. Append-only, like AppliedFee/PaymentAllocation:
/// no update/delete anywhere in this system: a correction is a new note, not an edit of history.
model LoanNote {
  id            String      @id @default(uuid())
  loanAccountId String
  loanAccount   LoanAccount @relation(fields: [loanAccountId], references: [id])
  authorUserId  String
  author        User        @relation(fields: [authorUserId], references: [id])
  text          String

  createdAt DateTime @default(now())

  @@index([loanAccountId])
  @@map("loan_notes")
}

/// FEE-4: once applied to a specific loan, a fee amount is immutable even
/// if the underlying FeeRule is later edited.
model AppliedFee {
  id            String           @id @default(uuid())
  loanAccountId String
  loanAccount   LoanAccount      @relation(fields: [loanAccountId], references: [id])
  feeRuleId     String
  feeRule       FeeRule          @relation(fields: [feeRuleId], references: [id])
  amount        Decimal          @db.Decimal(14, 2)
  taxAmount     Decimal          @default(0) @db.Decimal(14, 2)
  appliedAt     DateTime         @default(now())
  transactionId String?
  transaction   LoanTransaction? @relation(fields: [transactionId], references: [id])

  legacyId String? @unique

  @@map("applied_fees")
}

// ----------------------------------------------------------------------------
// Documents — DOC-1..4
// DOC-3: storage location is abstracted behind IStorageService; storageKey
// is an opaque key resolved by whichever adapter (local disk now,
// S3-compatible later) is configured. ADR-006 (physical legacy file blobs
// unresolved) does not block this table — it only blocks migrating the
// 21,104 legacy attachment records' actual files, which is out of scope
// for this build per the agreed migration-scope decision.
// ----------------------------------------------------------------------------

model Attachment {
  id               String                      @id @default(uuid())
  ownerType        AttachmentOwnerType
  ownerId          String
  fileName         String
  fileType         String
  /// Bytes on disk — absent for pre-existing legacy-migrated rows (nullable), always set for
  /// uploads through the new attachment-upload feature (2026-07-10).
  fileSize         Int?
  storageKey       String
  documentCategory AttachmentDocumentCategory?
  uploadedByUserId String?
  uploadedBy       User?                       @relation("AttachmentUploadedBy", fields: [uploadedByUserId], references: [id])
  uploadedAt       DateTime                    @default(now())

  legacyId String? @unique

  @@index([ownerType, ownerId])
  @@map("attachments")
}

enum ProfileNoteOwnerType {
  BORROWER
  LOAN_ACCOUNT
  LOAN_APPLICATION
}

/// Free-text note attached to a Borrower/LoanAccount/LoanApplication - same polymorphic
/// ownerType/ownerId shape as `Attachment` (ADR-014), for the same reason: no dedicated FK relation
/// per owner type. Immutable once created (no edit/delete use case) - a running log, not a wiki.
///
/// 2026-07-13 (merge note, renamed same day): distinct from `LoanNote` above, added independently
/// in a parallel branch of work - both model "a free-text note," `LoanNote` scoped to loan
/// accounts only (MIS-deletable, audit-trailed), this one generalized to Borrower/LoanApplication
/// too (no delete). Kept both - genuinely different capabilities, not a duplicate to unify -
/// renamed `Note` → `ProfileNote` (mirrors the existing `ProfileActivityLog` naming convention for
/// "spans multiple profile types") so the two are never confused for one another again.
model ProfileNote {
  id           String               @id @default(uuid())
  ownerType    ProfileNoteOwnerType
  ownerId      String
  text         String
  /// 2026-08-13 (SDevTech "comments" collection backfill, user request): nullable to allow migrated
  /// legacy notes with no corresponding User record (this codebase never migrated legacy staff
  /// accounts into `User`) — every note created through the app itself still always supplies a real
  /// author. `PrismaProfileNoteRepository`'s existing `row.author ? ... : null` already handled a
  /// null author gracefully before this change (defensive code that had no way to trigger until now).
  authorUserId String?
  author       User?                @relation("ProfileNoteAuthor", fields: [authorUserId], references: [id])
  createdAt    DateTime             @default(now())
  /// Same idempotent-upsert convention as every other migrated table (`legacyId @unique`) — lets
  /// `migrate-legacy-data.ts` re-run against a newer SDevTech snapshot without duplicating notes.
  legacyId     String?              @unique

  @@index([ownerType, ownerId])
  @@map("profile_notes")
}

/// ADR-051: repurposes the table originally scaffolded (init migration) for the legacy SDevTech
/// `document_templates` collection (`contentHtml`, HTML-based) — that migration path was
/// investigated and deliberately NOT taken (ADR-051 §6: 507 rows collapse to 365 sprawling
/// historical variants, and the per-product mapping references a Mambu-era product catalog that
/// doesn't join to any currently-migrated `LoanProductVersion.legacyId`). Nothing in `src/` ever
/// referenced the old shape, so no data migration is needed — this is the first real use of these
/// two tables.
///
/// One row per document type (11 total: 4 required + 7 conditional — see ADR-051 §1). `code` is
/// the stable identifier the generation code uses to find the matching `.docx` file under
/// `app/backend/templates/`. Required documents (`isRequired: true`) apply to every loan and have
/// no `DocumentTemplateMapping` rows; conditional documents are linked to the Loan Products they
/// apply to via that table.
model DocumentTemplate {
  id         String  @id @default(uuid())
  code       String  @unique
  name       String
  isRequired Boolean @default(false)
  sortIndex  Int     @default(0)

  /// 2026-07-25 (e-signature, phase 2): which party(ies) must sign this template, independent of
  /// isRequired/DocumentTemplateMapping (those control whether the doc is generated at all for a
  /// loan; these control which signing batch(es) it's included in once generated). Most templates
  /// are borrower=true/coBorrower=false (the pre-existing default). A template with BOTH true (e.g.
  /// Loan Agreement - Seafarer, Special Power of Attorney) carries two separate anchors in its
  /// .docx ([[SIGNATURE_ANCHOR]] and [[SIGNATURE_ANCHOR_CO_BORROWER]]) and is stamped twice, once
  /// per party, onto the same evolving PDF. Deed of Assignment - Co-Borrower is the one template
  /// with borrower=false/coBorrower=true (co-borrower-only; never belongs in the borrower's batch).
  requiresBorrowerSignature   Boolean @default(true)
  requiresCoBorrowerSignature Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productLinks       DocumentTemplateMapping[]
  generatedDocuments GeneratedLoanDocument[]

  @@map("document_templates")
}

/// Only ever holds CONDITIONAL document templates (ADR-051 §1/§3) — required templates apply
/// universally and never get a row here, so this table's size reflects only the per-product
/// variation, not every template x every product.
model DocumentTemplateMapping {
  loanProductId      String
  documentTemplateId String
  loanProduct        LoanProduct      @relation(fields: [loanProductId], references: [id], onDelete: Cascade)
  documentTemplate   DocumentTemplate @relation(fields: [documentTemplateId], references: [id], onDelete: Cascade)

  @@id([loanProductId, documentTemplateId])
  @@map("document_template_mappings")
}

/// Append-only (ADR-051 §3) — matches this project's ledger philosophy (TXN-1, `LoanNote`,
/// `PaymentAllocation`): "Regenerate" in the UI always inserts a new row rather than overwriting,
/// so a document a borrower has already been shown/signed is never silently erased from the
/// record, even after a later data correction. The Documents tab shows the latest row per
/// `documentTemplateId` for a loan, with older ones available as history.
model GeneratedLoanDocument {
  id            String      @id @default(uuid())
  loanAccountId String
  loanAccount   LoanAccount @relation(fields: [loanAccountId], references: [id])

  documentTemplateId String
  documentTemplate   DocumentTemplate @relation(fields: [documentTemplateId], references: [id])

  /// Key into the existing local storage abstraction (DOC-3, `app/backend/storage/`).
  storageKey String

  generatedByUserId String
  generatedBy       User     @relation("LoanDocumentGeneratedBy", fields: [generatedByUserId], references: [id])
  generatedAt       DateTime @default(now())

  signingDocuments LoanSigningDocument[]

  @@index([loanAccountId])
  @@map("generated_loan_documents")
}

/// 2026-07-25 (e-signature, phase 2 - two-party signing): which party a LoanSigningSession's
/// batch and SMS link are for.
enum SigningPartyType {
  BORROWER
  CO_BORROWER
}

/// 2026-07-22 (e-signature, phase 1 - required documents only, see ADR-051 §1 for the
/// required/conditional split): batches a loan's required `GeneratedLoanDocument` rows into ONE
/// signing session sent to the client via a single SMS link. The raw link token and OTP code are
/// NEVER stored - only HMAC-SHA256 hashes (same scheme as `RefreshToken.tokenHash`), so a DB leak
/// alone can't forge either. `otpVerifiedAt` covers the WHOLE session (client verifies once,
/// signs every document in the same visit) - resuming after it ages past the reverify window
/// requires a fresh OTP (2026-07-22 user decision), not a brand-new link/session.
model LoanSigningSession {
  id            String      @id @default(uuid())
  loanAccountId String
  loanAccount   LoanAccount @relation(fields: [loanAccountId], references: [id])

  /// 2026-07-25: which party this batch is for - determines which templates get included
  /// (DocumentTemplate.requiresBorrowerSignature/requiresCoBorrowerSignature) and which signature
  /// anchor gets stamped ([[SIGNATURE_ANCHOR]] vs [[SIGNATURE_ANCHOR_CO_BORROWER]]) on documents
  /// that need both. Defaults to BORROWER to match every session created before this field existed.
  partyType    SigningPartyType @default(BORROWER)
  /// Set only when partyType=CO_BORROWER - which CoBorrower this session/phone number belongs to.
  /// Null for BORROWER sessions (the loan account's own borrower is implied by loanAccountId).
  coBorrowerId String?
  coBorrower   CoBorrower?      @relation(fields: [coBorrowerId], references: [id])

  /// Where the SMS link and OTP are sent - captured at send time, not re-read from the borrower
  /// record later, so a later profile edit can't silently redirect an in-flight signing session.
  phoneNumber String
  /// 2026-07-28: which channel delivered the link - the OTP (via RequestSigningOtpUseCase) follows
  /// this SAME channel, so a link sent by email also gets its OTP by email. Defaults to SMS to
  /// match every session created before this field existed.
  channel     String    @default("SMS")
  /// Set only when channel=EMAIL - captured at send time for the same reason as phoneNumber above.
  email       String?
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?

  otpCodeHash   String?
  otpExpiresAt  DateTime?
  otpVerifiedAt DateTime?

  createdByUserId String
  createdBy       User     @relation("LoanSigningSessionCreatedBy", fields: [createdByUserId], references: [id])
  createdByIp     String?
  createdAt       DateTime @default(now())

  documents        LoanSigningDocument[]
  notificationLogs SigningNotificationLog[]

  @@index([loanAccountId])
  @@map("loan_signing_sessions")
}

/// 2026-07-29 (user request): "may OTP sms and email log ba tayo?" - previously neither the
/// signing-link send nor the OTP send left any persistent record (only ephemeral server logs, and
/// LoanSigningSession's own otpCodeHash/otpExpiresAt get overwritten on every resend, so there was
/// no history). One row per LINK send (CreateLoanSigningSessionUseCase) or OTP send
/// (RequestSigningOtpUseCase) - immutable, append-only, mirroring SmsReminderLog/EmailReminderLog's
/// own "log every send, never overwrite" posture. `verifiedAt` is set only on the specific OTP row
/// that was actually verified (LoanSigningSession.verifyOtp always checks against the latest-issued
/// code, so this is always the most recent OTP row for that session at the time of verification) -
/// left null forever on LINK rows and on superseded/never-verified OTP rows.
enum SigningNotificationType {
  LINK
  OTP
}

model SigningNotificationLog {
  id                   String                  @id @default(uuid())
  loanSigningSessionId String
  loanSigningSession   LoanSigningSession      @relation(fields: [loanSigningSessionId], references: [id], onDelete: Cascade)
  loanAccountId        String
  loanAccount          LoanAccount             @relation(fields: [loanAccountId], references: [id])
  type                 SigningNotificationType
  partyType            SigningPartyType
  channel              String
  recipient            String
  sentAt               DateTime                @default(now())
  verifiedAt           DateTime?

  @@index([loanAccountId])
  @@index([loanSigningSessionId])
  @@map("signing_notification_logs")
}

/// One row per document in the batch, in signing order (`sortIndex`). `signedStorageKey` is a NEW
/// PDF (the original `GeneratedLoanDocument`'s PDF with the signature image + audit text stamped
/// onto the last page via pdf-lib) - the original row/file is never modified, matching its own
/// append-only convention (see `GeneratedLoanDocument`'s doc comment).
model LoanSigningDocument {
  id        String             @id @default(uuid())
  sessionId String
  session   LoanSigningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  generatedLoanDocumentId String
  generatedLoanDocument   GeneratedLoanDocument @relation(fields: [generatedLoanDocumentId], references: [id])
  sortIndex               Int

  signedAt         DateTime?
  signedStorageKey String?
  signedByIp       String?
  signedUserAgent  String?

  @@unique([sessionId, generatedLoanDocumentId])
  @@map("loan_signing_documents")
}

/// Statement of Account (ADR-051 §1/§9: explicitly out of scope for the 11-document required/
/// conditional pipeline above — a separate, on-demand, per-request document, not tied to
/// `DocumentTemplate`/`DocumentTemplateMapping`). Append-only like `GeneratedLoanDocument`: every
/// generation is its own permanent, immutable snapshot of the figures shown to/sent to the
/// borrower at that moment — a later payment or penalty accrual must never silently change what an
/// already-generated SOA says. Collection Fee and Other Fee are staff-entered per generation (no
/// system field for either, confirmed against the legacy Excel/VBA tool's own `txtCollectionFee`/
/// `txtotherfee` manual input boxes), so they're stored here rather than derived.
/// 2026-08-12 (user-confirmed) — how a Statement of Account arrived at its Penalty figure.
enum SoaPenaltyMode {
  /// Default. Takes each installment's penalty straight from the repayment schedule: the frozen
  /// SDevTech snapshot for a migrated loan, the live ADR-050 figure for one originated here. The
  /// SOA and the schedule therefore agree by construction, and no dates are asked for.
  RECORDED
  /// Keeps every recorded figure and computes ONLY the installments that have none, over a
  /// staff-entered date range (per-installment days, capped at the loan's maturity date). For the
  /// ~2% of migrated loans where SDevTech never recorded any penalty at all.
  COMPUTED
  /// 2026-08-12 (user-confirmed): staff type the figure themselves, with a required reason. For the
  /// long-defaulted migrated accounts whose recorded penalty includes years of post-maturity
  /// accrual the business no longer charges — 681 loans carry ~PHP 19.3M of it on their final
  /// installment alone. Those are settled case by case, and SDevTech's own accrual formula could
  /// not be derived from the dump, so no automatic figure would be honest here.
  MANUAL
}

model GeneratedStatementOfAccount {
  id            String      @id @default(uuid())
  loanAccountId String
  loanAccount   LoanAccount @relation(fields: [loanAccountId], references: [id])

  /// Display format `SOA-{5-digit soaSequenceNumber}-{MMDDYYYY of generatedAt}` (e.g.
  /// `SOA-00001-07192026`), matching the legacy Excel/VBA tool's own numbering. A PER-LOAN-ACCOUNT
  /// running counter (confirmed 2026-07-19 against the tool's actual VBA source -
  /// `wsLoan.Cells(r, 26)`, incremented per the specific loan account row found - correcting an
  /// earlier "global counter" assumption made from a screenshot alone). Computed similarly to
  /// `LoanAccount.loanCode` (`CreateLoanAccountUseCase.generateLoanCode`'s own doc comment) - plain
  /// "max existing + 1 for this loanAccountId" at generation time, not a Postgres-native sequence/
  /// autoincrement column - because the number must be known BEFORE the PDF is filled (it's a
  /// placeholder on the document itself), and this is a low-frequency, staff-driven action where
  /// that non-atomic read-then-use is an accepted tradeoff, same as the loan code precedent.
  soaSequenceNumber Int

  /// 2026-08-12 (user-confirmed): which of the two penalty sources produced `pastDuePenalty`.
  /// Recorded without a default so a statement can always be explained and reproduced later —
  /// without it there is no way to tell why a given SOA showed the penalty it did.
  penaltyMode SoaPenaltyMode

  /// `penaltyFromDate`/`penaltyToDate` (2026-07-19, user request, corrected from a single
  /// `penaltyAsOfDate`): a manually-entered date RANGE for the Penalty computation.
  ///
  /// 2026-08-12: nullable, because `penaltyMode = RECORDED` (the default) takes the penalty
  /// straight off the repayment schedule and asks staff for no dates at all.
  penaltyFromDate         DateTime? @db.Date
  penaltyToDate           DateTime? @db.Date
  accruedInterestAsOfDate DateTime  @db.Date

  /// Required under `penaltyMode = MANUAL`, null otherwise. Without it a statement showing a
  /// hand-set penalty could never be explained against the schedule it disagrees with.
  penaltyManualReason String?

  currentAmortizationDue Decimal @db.Decimal(14, 2)
  pastDuePrincipal       Decimal @db.Decimal(14, 2)
  pastDueInterest        Decimal @db.Decimal(14, 2)
  pastDuePenalty         Decimal @db.Decimal(14, 2)
  totalPastDue           Decimal @db.Decimal(14, 2)
  accruedInterest        Decimal @db.Decimal(14, 2)
  collectionFee          Decimal @db.Decimal(14, 2)
  otherFee               Decimal @db.Decimal(14, 2)
  totalAmountDue         Decimal @db.Decimal(14, 2)

  /// Key into the existing local storage abstraction (DOC-3, `app/backend/storage/`).
  storageKey String

  generatedByUserId String
  generatedBy       User     @relation("StatementOfAccountGeneratedBy", fields: [generatedByUserId], references: [id])
  generatedAt       DateTime @default(now())

  @@index([loanAccountId])
  @@map("generated_statements_of_account")
}

// ----------------------------------------------------------------------------
// Audit — AUDIT-1, AUDIT-2
// Append-only. No update/delete path is exposed anywhere in the
// application for this table.
// ----------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  /// Schema Review SR-13: time-range audit browsing and per-user audit
  /// queries were previously unsupported beyond (entityType, entityId).
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_PRE_APPROVAL_READY
  APPLICATION_DECIDED
  LOAN_OVERDUE
}

/// Notification Center (2026-07-17 user request). Distinct from AuditLog (which is a write/
/// page-view trail, MIS-only) - these are user-visible "things needing your attention," created as
/// a side effect of real domain events (LoanApplication submitted/tagged-pre-approval/decided) or,
/// for LOAN_OVERDUE, by a real periodic scheduler (see OverdueNotificationScheduler.ts, started
/// from server.ts). entityType/entityId link back to the source record, same pattern as AuditLog.
model Notification {
  id              String           @id @default(uuid())
  recipientUserId String
  recipient       User             @relation(fields: [recipientUserId], references: [id])
  type            NotificationType
  title           String
  body            String?
  entityType      String?
  entityId        String?
  branchId        String
  branch          Branch           @relation(fields: [branchId], references: [id])
  read            Boolean          @default(false)
  readAt          DateTime?
  createdAt       DateTime         @default(now())

  @@index([recipientUserId, read, createdAt])
  @@index([type, entityId, createdAt])
  @@map("notifications")
}

enum SmsReminderStatus {
  SENT
  DELIVERED
  UNDELIVERED
  REJECTED
  FAILED
}

/// The 5-stage business-confirmed reminder schedule (2026-07-12 decision, previously only
/// simulated in `LoanDetailPage.tsx`'s `RealRemindersPanel`/`computeReminderTriggers` - now the
/// real trigger set the backend actually sends against). The 4 date-anchored triggers fire once
/// each, relative to a loan's next-due installment; `PAST_DUE_WEEKLY` fires every Monday
/// (Asia/Manila), uncapped, for as long as the loan has any overdue unpaid installment.
enum ReminderTriggerType {
  FIVE_DAYS_BEFORE
  THREE_DAYS_BEFORE
  ONE_DAY_BEFORE
  DUE_DATE
  PAST_DUE_WEEKLY
}

/// Auto SMS Payment Reminders (2026-07-18 user request, via the existing M360/Globe SMS API
/// already used by the legacy SDevTech system - see
/// legacy/reports/M360 SMS API and Passthru Version 3.3.4.pdf). One row per reminder SEND ATTEMPT
/// - a single loan can now accumulate up to 5 rows (one per trigger type) plus a growing weekly
/// tail from PAST_DUE_WEEKLY, so idempotency is `@@unique([loanAccountId, triggerType,
/// triggerDate])` (not `installmentId` alone anymore - a loan has no single stable "the"
/// installment once PAST_DUE_WEEKLY sums across every overdue one). `triggerDate` is the Asia/
/// Manila calendar date this specific trigger instance fired on - for the 4 date-anchored
/// triggers it's the installment's own due-date-relative day; for PAST_DUE_WEEKLY it's that
/// Monday's date, which is what makes each week's send its own idempotent row.
/// `installmentId` is nullable: set to the anchor installment for the 4 date-based triggers, null
/// for PAST_DUE_WEEKLY (which sums across every overdue installment, not one). `status` starts at
/// SENT (M360 accepted the broadcast, code 201) and is updated to DELIVERED/UNDELIVERED/REJECTED
/// by the DLR webhook when M360 calls back with the telco's actual delivery outcome; FAILED means
/// M360 itself rejected the send (non-201 response) - no DLR follow-up expected for that case.
model SmsReminderLog {
  id            String              @id @default(uuid())
  loanAccountId String
  loanAccount   LoanAccount         @relation(fields: [loanAccountId], references: [id])
  installmentId String?
  installment   RepaymentSchedule?  @relation(fields: [installmentId], references: [id])
  triggerType   ReminderTriggerType
  triggerDate   DateTime

  phoneNumber String
  message     String

  status          SmsReminderStatus @default(SENT)
  providerTransId String?
  errorMessage    String?

  sentAt      DateTime  @default(now())
  deliveredAt DateTime?

  @@unique([loanAccountId, triggerType, triggerDate])
  @@index([loanAccountId])
  @@index([installmentId])
  @@index([providerTransId])
  @@map("sms_reminder_logs")
}

enum EmailReminderStatus {
  SENT
  FAILED
}

/// Auto Email Payment Reminders (2026-07-18, same Reminders feature as SmsReminderLog, second
/// channel) - via the company's own Google Workspace SMTP (Gmail "Send As" alias
/// collections@easycash.ph on a real mailbox, per CLAUDE.md "avoid unnecessary paid cloud
/// services" - no separate paid transactional email service needed). Mirrors SmsReminderLog's
/// shape and idempotency key exactly (`@@unique([loanAccountId, triggerType, triggerDate])`) -
/// same 5-stage trigger schedule, same content (user-confirmed: identical wording to the SMS
/// templates). No DLR-equivalent here - plain SMTP only reports accept/reject at send time, so
/// `status` only ever ends at SENT or FAILED, never DELIVERED (unlike SmsReminderLog, which gets
/// a real delivery outcome from M360's DLR webhook).
model EmailReminderLog {
  id            String              @id @default(uuid())
  loanAccountId String
  loanAccount   LoanAccount         @relation(fields: [loanAccountId], references: [id])
  installmentId String?
  installment   RepaymentSchedule?  @relation(fields: [installmentId], references: [id])
  triggerType   ReminderTriggerType
  triggerDate   DateTime

  recipientEmail String
  message        String

  status       EmailReminderStatus @default(SENT)
  errorMessage String?

  sentAt DateTime @default(now())

  @@unique([loanAccountId, triggerType, triggerDate])
  @@index([loanAccountId])
  @@map("email_reminder_logs")
}

// ----------------------------------------------------------------------------
// Profile Activity Timeline — ADR-050
// Track loan officer actions on Loan Applications, Borrowers, and Loan Accounts
// for compliance and auditability. Immutable after creation (soft-delete only).
// Separate from AuditLog — this is user-visible activity; AuditLog is
// system-level audit trail.
// ----------------------------------------------------------------------------

enum ProfileType {
  LOAN_APPLICATION
  BORROWER
  LOAN_ACCOUNT
}

model ProfileActivityLog {
  id                   String      @id @default(uuid())
  profileType          ProfileType
  profileId            String
  userId               String
  user                 User        @relation("ProfileActivityLogUser", fields: [userId], references: [id], onDelete: Restrict)
  action               String
  /// JSON object with action-specific details (attachmentId, documentCategory,
  /// decisionStatus, paymentAmount, etc.). See ADR-050 for examples per action type.
  details              Json
  visibilityRestricted Boolean     @default(false)
  createdAt            DateTime    @default(now())
  deletedByMisAt       DateTime?
  /// Soft delete: if set, MIS deleted this record at this time.

  @@index([profileType, profileId])
  @@index([userId])
  @@index([createdAt])
  @@map("profile_activity_logs")
}

// ----------------------------------------------------------------------------
// Idempotency — Milestone 9.1/9.2 CP13
// (docs/Architecture/MILESTONE_9_IMPLEMENTATION_ROADMAP_V2.md, Decision Log
// #9): a client-supplied Idempotency-Key header, checked via this small,
// purpose-built lookup (deliberately separate from AuditLog, which records
// history, not replay state), rejecting a duplicate resubmission before it
// reaches the use case layer.
//
// 2026-07-08 (H-4 fix): statusCode/responseBody are nullable because a row is
// now inserted as a claim BEFORE the use case runs (both null = "in
// progress"), not just after it succeeds. This is what makes the @@unique
// constraint actually block a concurrent duplicate: the second request's
// claim-insert itself hits P2002, before it ever reaches the use case layer,
// instead of only detecting the collision afterward. A row can be deleted by
// `release()` if its own claiming request's use case throws — the only
// update/delete paths this table has, both scoped to the row's own
// still-pending (statusCode IS NULL) state.
// ----------------------------------------------------------------------------

// ----------------------------------------------------------------------------
// Loan Applications — Milestone 9.2
//
// The pre-underwriting intake/review workflow that gates loan account
// creation on the frontend's mock UI (a new/renewal loan account may only be
// created from a specific, still-unconverted APPROVED application). This
// pass covers intake, review, and the approve/decline/revert decision only —
// deliberately NOT the "Approved application -> create Borrower -> create
// LoanAccount" conversion step, which stays a separate follow-up so each
// piece can be verified independently (confirmed with the business owner,
// 2026-07-09).
//
// Fields mirror the frontend's MockLoanApplication only for what this pass
// persists — the paper intake form (ECLC-LOFN01) collects many more fields
// (nickname, TIN, SSS, dependents, character references, etc.) shown on the
// create form for workflow completeness but never persisted even in the mock
// today; not modeled here either pending a real requirement to store them.
// AI risk/recommendation is explicitly a frontend-only rule-based demo, never
// a real ML engine — not modeled backend-side at all.
/// PREAPPROVED/PREDECLINED are computed by LoanApplicationPreQualificationService at creation and
/// re-computed whenever the AI Risk Management Summary is saved (advisory only — the officer makes
/// the real, final APPROVED/DECLINED call; system verdicts never auto-approve or auto-decline).
enum LoanApplicationStatus {
  PREAPPROVED
  PREDECLINED
  UNDER_REVIEW
  PRE_APPROVAL
  APPROVED
  DECLINED
}

/// 2026-07-16 (Under Review / Pre Approval stages) — result of the CRM/credit-risk team's manual
/// Credit Bureau check, captured on LoanApplication.reviewReport during UNDER_REVIEW.
enum CreditBureauResult {
  CLEAR
  FLAGGED
  NO_RECORD_FOUND
}

enum LoanApplicationAccountType {
  NEW
  RENEWAL
}

model LoanApplication {
  id       String @id @default(uuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  /// 2026-07-14: set only when this application was created FROM an existing client's profile
  /// ("Create Loan Application" / renewal flow) - distinct from `createdBorrower` (the reverse
  /// side of `Borrower.sourceApplicationId`, set when a walk-in application is later converted
  /// INTO a new borrower). This is the other direction: an existing borrower starting a new
  /// application. Lets "all LoanApplications for Borrower X" be queried directly.
  borrowerId String?
  borrower   Borrower? @relation("LoanApplicationBorrower", fields: [borrowerId], references: [id])

  /// 2026-07-23 (Easycash Portal Phase 2) - set when this application was submitted by a client
  /// through the portal, as opposed to encoded by staff (encodedByUserId) or a legacy walk-in.
  /// Lets the client see their own submitted applications' status without a Borrower link yet.
  portalAccountId String?
  portalAccount   PortalAccount? @relation(fields: [portalAccountId], references: [id])

  applicantName                String
  age                          Int?
  gender                       String?
  civilStatus                  String?
  birthDate                    DateTime?
  placeOfBirth                 String?
  nationality                  String?
  homeOwnership                String?
  /// Flattened, human-readable join of the structured fields below - kept for existing display
  /// code/history. The structured fields are what "Create Client Profile" copies into a real
  /// `Address` row - parsing this flattened string back apart would be lossy/ambiguous.
  address                      String?
  houseUnitNumber              String?
  street                       String?
  barangay                     String?
  cityMunicipality             String?
  province                     String?
  zipCode                      String?
  /// 2026-07-22 - captured only at intake (create form), like the fields above; never edited
  /// afterward. Defaults true - most applicants haven't moved. When false, the previous* fields
  /// below hold a distinct address, same flat-field shape as the present address above.
  previousAddressSameAsPresent Boolean   @default(true)
  previousAddress              String?
  previousHouseUnitNumber      String?
  previousStreet               String?
  previousBarangay             String?
  previousCityMunicipality     String?
  previousProvince             String?
  previousZipCode              String?
  monthlyIncome                Decimal?  @db.Decimal(14, 2)
  employer                     String?
  occupation                   String?
  officeAddress                String?
  tinNumber                    String?
  sssNumber                    String?
  propertiesOwned              String[]  @default([])
  creditScore                  Int?
  /// 2026-07-25: superseded by the structured coBorrowerFirstName/MiddleName/LastName fields below
  /// for new intake - kept read-only for older applications that only ever had this single
  /// combined "Name (relationship)" string, since re-parsing it apart is lossy/ambiguous (see
  /// splitApplicantName's own doc comment on the frontend). Never written to by new intake.
  coBorrowerName               String?
  coBorrowerFirstName          String?
  coBorrowerMiddleName         String?
  coBorrowerLastName           String?
  coBorrowerEmployer           String?
  coBorrowerContactNumber      String?
  coBorrowerEmail              String?
  coBorrowerAddress            String?
  mobilePhone                  String?
  email                        String?
  /// {name, age, relationship}[] - display/reference only, no independent query need (mirrors
  /// `propertiesOwned`'s "small list, no relational value" reasoning).
  dependants                   Json?
  reference1Name               String?
  reference1Mobile             String?
  reference2Name               String?
  reference2Mobile             String?
  /// Free-text catch-all for anything staff wants to note at intake that doesn't have its own
  /// field - carried over as-is into the Client Profile's own `note` field on creation.
  note                         String?

  referralSource      String?
  accountType         LoanApplicationAccountType?
  loanPurpose         String?
  requestedCategory   String
  requestedAmount     Decimal                     @db.Decimal(14, 2)
  requestedTermMonths Int
  /// Ticked-checklist of document names the applicant submitted at intake
  /// (e.g. "Valid ID", "Proof of Billing") — no file upload/storage exists
  /// yet, this is metadata only, matching the mock's `submittedDocuments`.
  submittedDocuments  String[]                    @default([])

  encodedByUserId String?
  /// Set only for a walk-in/branch-encoded application (staff filled the
  /// paper form on the applicant's behalf) — null for a self-service intake.
  encodedBy       User?   @relation("LoanApplicationEncodedBy", fields: [encodedByUserId], references: [id])

  status               LoanApplicationStatus @default(PREDECLINED)
  /// Cached at creation from geocoding the applicant's address against the assigned branch's
  /// coordinates — null if geocoding failed/was inconclusive (the distance rule fails open in that
  /// case; see LoanApplicationPreQualificationService).
  distanceFromBranchKm Decimal?              @db.Decimal(6, 2)

  /// 2026-07-24 (user request) — the applicant's DEVICE GPS coordinates at the moment of
  /// submission, captured only for a portal (self-service) submission via the browser's
  /// Geolocation API. Deliberately optional/best-effort: if the applicant denies the permission
  /// prompt or their browser doesn't support it, submission still proceeds with both null - this
  /// is a supporting signal for staff review, never a gate. Distinct from distanceFromBranchKm
  /// above, which is geocoded from the typed address text, not the device's actual location.
  submissionLatitude  Decimal? @db.Decimal(9, 6)
  submissionLongitude Decimal? @db.Decimal(9, 6)

  /// Staff picks the specific product sub-type during review — approval is
  /// blocked until this is set (mirrors the mock UI's rule).
  assignedLoanProductVersionId String?
  assignedLoanProductVersion   LoanProductVersion? @relation(fields: [assignedLoanProductVersionId], references: [id])

  reviewedByUserId String?
  reviewedBy       User?     @relation("LoanApplicationReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  /// Free-text reason recorded on approve/decline/revert — required by the
  /// mock UI's confirmation dialog, kept optional here since the API layer
  /// enforces "required" rather than the schema.
  decisionNote     String?

  /// 2026-07-16 (Under Review / Pre Approval stages) — set once when "Start Review" moves
  /// PREAPPROVED -> UNDER_REVIEW. Deliberately separate from reviewedByUserId/reviewedAt above
  /// (which record the FINAL approve/decline/revert actor and get overwritten every transition) -
  /// these two are per-stage and never overwritten once set.
  reviewStartedByUserId String?
  reviewStartedBy       User?     @relation("LoanApplicationReviewStartedBy", fields: [reviewStartedByUserId], references: [id])
  reviewStartedAt       DateTime?

  /// Structured Review Report captured during UNDER_REVIEW, locked once status leaves UNDER_REVIEW
  /// - mirrors the `dependants Json?` precedent (small object, no independent query need). Shape:
  /// { ciNotes?: string; creditBureauResult?: CreditBureauResult; creditBureauScore?: string;
  /// checkedDocuments: string[] }.
  reviewReport Json?

  /// Set when "Tag as Pre Approval" moves UNDER_REVIEW -> PRE_APPROVAL.
  preApprovedByUserId String?
  preApprovedBy       User?     @relation("LoanApplicationPreApprovedBy", fields: [preApprovedByUserId], references: [id])
  preApprovedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Reverse side of Borrower.sourceApplicationId - set once "Create Client Profile" has been
  /// used on this application.
  createdBorrower Borrower? @relation("LoanApplicationCreatedBorrower")

  /// Reverse side of LoanAccount.sourceApplicationId (2026-07-16) - set once "Create Loan
  /// Account" has actually been used on THIS application. See that field's own doc comment for
  /// why this replaced a "borrower's most recent loan account" heuristic that broke for a
  /// borrower with more than one loan account across their history (e.g. a renewal).
  createdLoanAccount LoanAccount? @relation("LoanApplicationCreatedLoanAccount")

  @@index([branchId])
  @@index([borrowerId])
  @@index([status])
  @@index([portalAccountId])
  @@map("loan_applications")
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  /// Client-supplied key. Scoped per `endpoint` (below) via the compound
  /// unique constraint, so the same key value reused against two different
  /// endpoints is not treated as a collision.
  key          String
  /// e.g. "POST /loan-accounts/:id/activate" — identifies which action this
  /// key was recorded against; not a free-floating global namespace.
  endpoint     String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null while the claiming request's use case is still running.
  statusCode   Int?
  /// Null while the claiming request's use case is still running.
  responseBody Json?
  createdAt    DateTime @default(now())

  @@unique([key, endpoint])
  @@map("idempotency_keys")
}

/// Auto SMS/Email Payment Reminders master switches (2026-07-18 user request) - a single-row
/// table (`id` fixed to "singleton") so the automated daily cron jobs can check a live,
/// DB-backed value each run instead of a static `.env` var that requires a server restart to
/// change. `SMS_ENABLED`/`EMAIL_ENABLED` in `.env` remain the fallback default (used only if this
/// row somehow doesn't exist yet - seeded to false on first read otherwise); once this row exists,
/// it always wins. MIS-only to change (enforced by the HTTP layer's `requireRole('MIS')`, not
/// here), matching every other system-wide toggle in this codebase.
model ReminderSettings {
  id                  String   @id @default("singleton")
  smsEnabled          Boolean  @default(false)
  emailEnabled        Boolean  @default(false)
  /// 2026-07-22 - e-signature signing-link/OTP SMS. A SEPARATE switch from smsEnabled above
  /// (which also gates the payment-reminder cron, reaching many real clients at once) - lets MIS
  /// toggle e-signature SMS on/off for a one-off staff-triggered send without touching the
  /// reminder blast. Checked fresh on every send (DryRunAwareSmsGateway), no server restart needed.
  signingSmsEnabled   Boolean  @default(false)
  /// 2026-07-28 - e-signature signing-link EMAIL, as an alternative delivery channel to
  /// signingSmsEnabled above - added after confirming some Smart-network numbers silently
  /// filter/drop the signing-link SMS (link-containing messages specifically; a plain-text SMS to
  /// the same number went through fine). Checked fresh on every send (DryRunAwareEmailGateway), no
  /// server restart needed.
  signingEmailEnabled Boolean  @default(false)
  /// 2026-07-23 - Easycash Portal signup/password-reset OTP email. SEPARATE from emailEnabled
  /// above (payment reminders) and from staff 2FA (identity module's LoginUseCase/
  /// RequestTwoFactorSetupUseCase, which are NOT gated by this row at all - they keep using the
  /// static SMS_ENABLED/EMAIL_ENABLED env vars via the original shared OtpSender instance). Checked
  /// fresh on every send (PortalOtpSender), no server restart needed.
  portalEmailEnabled  Boolean  @default(false)
  /// 2026-07-23 - Easycash Portal signup/password-reset OTP SMS. Same "separate from staff 2FA"
  /// reasoning as portalEmailEnabled above.
  portalSmsEnabled    Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  updatedByUserId     String?
  updatedBy           User?    @relation(fields: [updatedByUserId], references: [id])

  @@map("reminder_settings")
}

/// Automated PH Lending/Finance News + Road/Weather Advisory feed (2026-08-06 user request) -
/// curated LINKS to real external articles (headline + short excerpt + link back to the source),
/// never republished full article content (copyright). Fetched on a daily cron
/// (`financeNewsScheduler.ts`) from a small, env-configured allowlist of RSS feeds, filtered by
/// keyword relevance, and published with NO human review step before appearing live - an explicit
/// user decision (accepted after being warned this trades away a moderation safety net) - so the
/// keyword filter and the hard-truncated `excerpt` length are the only automated guardrails.
enum ExternalNewsCategory {
  /// PH lending/banking/finance news - shown on the public News page.
  FINANCE
  /// Road/weather advisories around Metro Manila - relevant to clients/prospective clients and to
  /// onsite loan officers who need to report to the Easycash main office. Surfaced both in the
  /// homepage "News Flash" ticker and the News page.
  ADVISORY
}

model ExternalNewsLink {
  id          String               @id @default(uuid())
  category    ExternalNewsCategory
  title       String
  sourceName  String
  /// Dedupe key - the fetch job skips a URL it has already stored, so re-running the cron (or a
  /// feed re-listing the same item) never creates duplicates.
  sourceUrl   String               @unique
  /// Hard-truncated to ~200 chars server-side (see FetchExternalFinanceNewsUseCase) - a short
  /// pointer to the source, never the full article body.
  excerpt     String
  publishedAt DateTime
  fetchedAt   DateTime             @default(now())

  @@index([category, publishedAt])
  @@map("external_news_links")
}

/// System-wide announcement popup (2026-08-14 user request) - lets MIS give LMS staff and/or
/// Portal clients advance notice of scheduled/emergency maintenance or other system-wide news,
/// so users aren't caught off guard by unexpected downtime. MIS-authored content only (never
/// auto-generated) - distinct from ExternalNewsLink above, which is fetched from external RSS
/// feeds. Only the single most recent ACTIVE, non-expired, audience-matching row is ever shown to
/// a given app (GetActiveSystemAnnouncementUseCase) - this table also keeps every past
/// announcement (active=false rows) as a lightweight history for MIS's admin list.
enum SystemAnnouncementType {
  /// Scheduled or emergency maintenance / downtime - shown with warning styling.
  MAINTENANCE
  /// General news/update - shown with neutral/informational styling.
  NEWS
  /// Anything not covered by the above - shown with neutral styling, same as NEWS.
  GENERAL
}

model SystemAnnouncement {
  id           String                 @id @default(uuid())
  title        String
  body         String
  type         SystemAnnouncementType @default(GENERAL)
  /// Per-announcement audience targeting (2026-08-14 user-confirmed) - independent flags rather
  /// than a single enum, so MIS can target LMS only, Portal only, or both from the same form.
  showOnLms    Boolean                @default(true)
  showOnPortal Boolean                @default(true)
  /// MIS can turn an announcement off without deleting it (keeps the admin history intact).
  active       Boolean                @default(true)
  /// Optional auto-expiry (2026-08-14 user-confirmed) - once past, the announcement stops
  /// appearing without MIS needing to come back and manually deactivate it. Null = shown
  /// indefinitely until MIS deactivates it by hand.
  expiresAt    DateTime?

  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, expiresAt])
  @@map("system_announcements")
}
