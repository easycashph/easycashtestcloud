# Server
NODE_ENV=development
PORT=4000

# Database (PostgreSQL, per CLAUDE.md — Prisma ORM, no MongoDB in production)
DATABASE_URL=postgresql://easycash:easycash@localhost:5432/easycash?schema=public

# Auth (Milestone 6 — placeholders defined now so config validation is in place early)
JWT_ACCESS_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=change-me-in-production-min-32-chars-different
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS (comma-separated list — supports multiple local dev/preview frontends at once)
CORS_ORIGIN=http://localhost:5173

# Reverse proxy trust (Milestone 6 audit finding C-02). This MUST match your
# actual deployment topology, or you get either a broken login rate limiter
# (see app/README.md) or an IP-spoofing hole via X-Forwarded-For:
#   - Local dev / direct exposure with NO reverse proxy in front: "false" (default)
#   - Behind exactly one reverse proxy (e.g. nginx on the same host/Docker network): "1"
#   - Behind N proxy hops: "2", "3", etc.
#   - Trust only specific proxy IPs/subnets: e.g. "127.0.0.1,10.0.0.0/8" or "loopback"
TRUST_PROXY=false

# Local document storage (DOC-3: abstracted, swappable for S3-compatible storage later)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
