// ============================================================================
// EasyCash Digital Lending Platform — Database Schema
// ============================================================================
// Authoritative source: repository-root `docs/` — Phase 0 Discovery, Phase 1
// Core Domain Model, Domain Glossary, Phase 1.5 Domain Invariants, and the
// Architecture Decision Register (ADR).
//
// Every model cites the rule ID(s) / ADR(s) it implements or provisionally
// works around. Do not add a field, enum value, or table that is not
// traceable to that specification (Phase 1.5 rules FIN-5 / MIG-5).
//
// Explicitly out of scope for this schema (tracked, not forgotten):
// CustomField/CustomFieldValue, Guarantor (ADR-040), Group-held loans
// (ADR-004 — individual Borrower-held loans only, see LoanAccount below),
// Restructuring/Renewal/Write-off/Early-Settlement/Holiday-Rule structures
// (ADR-041), CIC submission tables, full RBAC policy engine (ADR-038).
//
// Working assumption pending resolution: ADR-032 (Loan Release vs.
// Disbursement) — this schema treats them as two distinct moments; see
// the comment on LoanAccount below.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums — every value is directly evidenced in Phase 0 legacy data or
// explicitly named in PROJECT_RULES.md. None are invented. Adding a value
// later is a normal migration, not a redesign.
// ----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BorrowerStatus {
  ACTIVE
  INACTIVE
}

enum AddressOwnerType {
  BORROWER
  CO_BORROWER
}

enum AttachmentOwnerType {
  BORROWER
  LOAN_ACCOUNT
  /// Added 2026-07-10 for the Loan Application intake attachment-upload feature — a scanned
  /// supporting document (payslip, valid ID, etc.) attached before a Borrower/LoanAccount exists.
  LOAN_APPLICATION
}

/// Tags a Loan Application intake attachment by what it actually is (valid ID vs. payslip vs.
/// profile picture, etc.) so a future risk-scoring feature can look up specific documents by type
/// instead of an undifferentiated attachment list. Nullable on Attachment — manual uploads via the
/// generic Attachments panel have no category.
enum AttachmentDocumentCategory {
  PROFILE_PICTURE
  VALID_ID_BORROWER
  VALID_ID_CO_BORROWER
  PROOF_OF_BILLING
  EMPLOYEE_ID
  BUSINESS_CLEARANCE
  CORPORATE_PAYSLIP
  SEAMANS_BOOK
  OVERSEAS_EMPLOYMENT_CERTIFICATE
}

/// LP-1: a Loan Product Version has exactly one interest calculation method.
enum InterestCalculationMethod {
  FLAT
  DECLINING_BALANCE
  DECLINING_BALANCE_DISCOUNTED
}

enum InterestType {
  SIMPLE_INTEREST
}

enum RepaymentScheduleMethod {
  FIXED
}

enum RepaymentPeriodUnit {
  MONTHS
}

enum SettlementOption {
  FULL_DUE_AMOUNTS
}

/// FIN-4: rounding behavior is defined per product and applied consistently.
enum RoundingMethod {
  NO_ROUNDING
  ROUND_REMAINDER_INTO_LAST_REPAYMENT
}

/// PEN-1: penalty calculation method is configurable per product.
enum PenaltyCalculationMethod {
  NONE
  OVERDUE_BALANCE_AND_INTEREST
  ON_REPAYMENT
}

/// FEE-2: a fee's amount is flat or a percentage — never hard-coded per loan.
enum FeeCalculationMethod {
  FLAT
  PERCENTAGE_OF_LOAN_AMOUNT
}

/// FEE-3: a fee applies only at its configured trigger point.
enum FeeTriggerEvent {
  DISBURSEMENT
  MANUAL
  CAPITALIZED_DISBURSEMENT
}

enum FeeApplicationType {
  REQUIRED
  OPTIONAL
}

/// LA-2 / ADR-011: lean, legacy-observed lifecycle (recommended option) —
/// the fuller PROJECT_RULES.md workflow (Draft/Submitted/Under
/// Review/Released/Cancelled) is deferred per ADR-011 until confirmed.
enum LoanAccountStatus {
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  ACTIVE_IN_ARREARS
  CLOSED
  CLOSED_WRITTEN_OFF
  CLOSED_REJECTED
}

/// TXN-1..2: append-only ledger entry types. Note: "DISBURSEMENT" is
/// spelled correctly here — the legacy `DISBURSMENT` typo is a
/// migration-mapping concern only, never reproduced in this new schema.
enum LoanTransactionType {
  DISBURSEMENT
  REPAYMENT
  FEE_CHARGED
  PENALTY_APPLIED
  INTEREST_APPLIED
  DEFERRED_INTEREST_APPLIED
  DEFERRED_INTEREST_PAID
  TRANSFER
  ADJUSTMENT
  REVERSAL
}

/// REPAY-3: status must be derivable from due/paid amounts and due date.
enum RepaymentInstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  LATE
}

// ----------------------------------------------------------------------------
// Identity & Access — ADR-038 (RBAC minimal placeholder, full design
// deferred), ADR-039 (no legacy password hash carry-over — this is a new
// system; User.legacyId exists only for identity traceability), AUDIT-3
// (configurable permissions, no hard-coded role checks), AUDIT-4 (minimum
// role baseline)
// ----------------------------------------------------------------------------

/// ADR-005 (Critical/Blocking, resolved provisionally): no legacy branch
/// list exists. Seeded with one placeholder "Head Office" branch. The
/// schema will never need to change when the real branch list is supplied —
/// only seed/admin data does.
model Branch {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  /// Physical office address — used to geocode the branch once (see
  /// LoanApplicationPreQualificationService) for the loan-application distance rule.
  address   String?
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  borrowers        Borrower[]
  loanAccounts     LoanAccount[]
  transactions     LoanTransaction[]
  loanApplications LoanApplication[]

  @@map("branches")
}

model User {
  id           String     @id @default(uuid())
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id])
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)

  /// Self-service profile fields (2026-07-12) - editable by the user themselves via
  /// `PATCH /users/me`, distinct from the MIS-only admin fields above (email/status/roles/
  /// companyId), which stay behind `PATCH /users/:id`.
  contactNumber String?
  address       String?
  birthday      DateTime?

  /// Internal employee/company ID (HR identifier) - distinct from `id` (the DB primary key) and
  /// `legacyId` (the migrated-system's own ID). Optional - existing migrated/seeded staff don't
  /// have one recorded yet.
  companyId String? @unique

  /// Organizational job-title label under the user's Role (e.g. "MIS Manager") - display/
  /// organizational only, does not affect access (see RoleClass doc comment).
  roleClassId String?
  roleClass   RoleClass? @relation(fields: [roleClassId], references: [id], onDelete: SetNull)

  /// Identity traceability only (Mambu `mambu_users` / SDevTech `users`).
  /// Credentials themselves are never migrated — ADR-039.
  legacyId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles                    UserRole[]
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  profileActivityLogs      ProfileActivityLog[] @relation("ProfileActivityLogUser")
  borrowersAsLoanOfficer   Borrower[]        @relation("BorrowerLoanOfficer")
  loanAccountsAsOfficer    LoanAccount[]     @relation("LoanAccountOfficer")
  loanAccountsApproved     LoanAccount[]     @relation("LoanAccountApprovedBy")
  transactionsPosted       LoanTransaction[] @relation("LoanTransactionPostedBy")
  attachmentsUploaded      Attachment[]      @relation("AttachmentUploadedBy")
  notesAuthored            Note[]            @relation("NoteAuthor")
  idempotencyKeys          IdempotencyKey[]
  loanApplicationsEncoded  LoanApplication[] @relation("LoanApplicationEncodedBy")
  loanApplicationsReviewed LoanApplication[] @relation("LoanApplicationReviewedBy")
  loanNotesAuthored        LoanNote[]
  loanDocumentsGenerated   GeneratedLoanDocument[] @relation("LoanDocumentGeneratedBy")

  @@map("users")
}

model Role {
  id          String  @id @default(uuid())
  /// AUDIT-4 baseline, seeded: MIS, Loan Operation Manager, CRM, Finance,
  /// Accounting, Collection Officer (ADR-038 §1, renamed 2026-07-06 from
  /// the original placeholder list — Administrator, Manager, Loan Officer,
  /// Cashier, Collection Officer, Viewer).
  name        String  @unique
  description String?

  users       UserRole[]
  permissions RolePermission[]
  roleClasses RoleClass[]

  @@map("roles")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Organizational job-title label under a Role (e.g. "MIS Manager"/"MIS Assistant" under the MIS
/// role) - display/organizational only, does NOT affect LMS access; actual permissions remain
/// governed entirely by Role/Permission above (ADR-043's flat role model is unchanged).
model RoleClass {
  id        String   @id @default(uuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@unique([roleId, name])
  @@map("role_classes")
}

/// AUDIT-3: permissions must be role-based and configurable in the
/// database, not hard-coded `if role === "Admin"` checks in application code.
model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Secure JWT refresh-token rotation store (Milestone 6).
model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdByIp String?
  createdAt   DateTime  @default(now())

  @@map("refresh_tokens")
}

// ----------------------------------------------------------------------------
// Loan Product — LP-1..5, LPV-1..4
// ADR-002: no retroactive reconstruction of legacy product-version history
// (recommended option adopted) — versioning is formal starting now.
// ADR-003: full version lineage (recommended option adopted).
// ADR-009: repayment allocation order — mechanism only, PENDING value.
// ----------------------------------------------------------------------------

/// Stable product identity only — see LoanProductVersion for the actual
/// versioned, immutable rule set (LPV-1).
model LoanProduct {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions              LoanProductVersion[]
  documentTemplateLinks DocumentTemplateMapping[]

  @@map("loan_products")
}

/// 2026-07-11 (Create Loan Account, Contractual Rate auto-fill): staff enters an Add-On Rate and
/// Term; the Contractual Rate actually used to run the declining-balance schedule (§1/§2 of
/// CALCULATION_ENGINE_SPEC.md) is looked up here rather than typed. Sourced directly from MIS
/// Nomer's own Excel LMS (`legacy/reports/BETA 1.5.83 LMSv3.xlsm`, sheet `Rate_details`) — real
/// data, not invented; one confirmed typo (Add-On 1.75%, Term 3: "242" -> 2.42) corrected with the
/// user's explicit confirmation before seeding. Global (not per-product) — no product column
/// exists in the source table; revisit if a per-product chart is ever needed.
model InterestRateChart {
  id                     String  @id @default(uuid())
  addOnRatePercent       Decimal @db.Decimal(6, 3)
  termMonths             Int
  contractualRatePercent Decimal @db.Decimal(6, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([addOnRatePercent, termMonths])
  @@map("interest_rate_chart")
}

/// LPV-1: every approved LoanAccount references a specific, immutable
/// version. Editing a product never affects loans already approved under
/// a prior version (LPV-3).
model LoanProductVersion {
  id            String      @id @default(uuid())
  loanProductId String
  loanProduct   LoanProduct @relation(fields: [loanProductId], references: [id])
  versionNumber Int

  /// ADR-003: full lineage — self-referencing predecessor link.
  previousVersionId String?             @unique
  previousVersion   LoanProductVersion? @relation("LoanProductVersionLineage", fields: [previousVersionId], references: [id])
  nextVersion       LoanProductVersion? @relation("LoanProductVersionLineage")

  /// LPV-2 (Hard Rule): only one version of a product may be Active at a
  /// time. Enforced at TWO layers, not one: the application layer
  /// (Milestone 7 use cases), AND, as of the Schema Review follow-up
  /// migration (Schema Review SR-30), a PostgreSQL partial unique index —
  /// `CREATE UNIQUE INDEX ... ON loan_product_versions(loanProductId)
  /// WHERE isActive = true` — added via raw SQL in
  /// prisma/migrations/20260702010000_schema_review_indexes_and_lpv2_guard.
  /// This lives in a hand-written SQL migration, NOT here as `@@unique`,
  /// because Prisma's schema DSL has no way to express a *conditional*
  /// (partial/filtered) unique constraint — `@@unique`/`@@index` in Prisma
  /// always apply to every row; there is no `WHERE` clause equivalent in
  /// the schema language itself, even though the underlying PostgreSQL
  /// feature (partial indexes) is fully supported when written as raw SQL.
  isActive      Boolean   @default(false)
  effectiveFrom DateTime
  effectiveTo   DateTime?

  interestCalculationMethod InterestCalculationMethod
  interestType              InterestType              @default(SIMPLE_INTEREST)
  /// Only one convention evidenced in legacy data (E30_360); kept as a
  /// plain string rather than a single-value enum pending confirmation
  /// that no other convention is ever used.
  daysInYearConvention      String                    @default("E30_360")
  repaymentScheduleMethod   RepaymentScheduleMethod   @default(FIXED)
  repaymentPeriodUnit       RepaymentPeriodUnit       @default(MONTHS)
  settlementOption          SettlementOption          @default(FULL_DUE_AMOUNTS)

  loanAmountMin     Decimal  @db.Decimal(14, 2)
  loanAmountMax     Decimal? @db.Decimal(14, 2)
  loanAmountDefault Decimal? @db.Decimal(14, 2)

  installmentCountMin     Int
  installmentCountMax     Int?
  installmentCountDefault Int?

  /// Legacy data shows grace periods effectively unused (type NONE across
  /// nearly all products) — kept configurable, not removed.
  gracePeriodType        String @default("NONE")
  gracePeriodDefaultDays Int    @default(0)

  roundingMethod RoundingMethod @default(NO_ROUNDING)

  /// ADR-009 PENDING: column exists so the mechanism is in place; no
  /// default value or split-calculation logic is implemented until the
  /// actual legacy allocation order is confirmed (Milestone 7 will stop
  /// and ask before implementing this specific calculation).
  repaymentAllocationOrder Json?

  defaultInterestRate Decimal? @db.Decimal(6, 3)
  minInterestRate     Decimal? @db.Decimal(6, 3)
  maxInterestRate     Decimal? @db.Decimal(6, 3)

  legacyId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  penaltyRule      PenaltyRule?
  feeRules         FeeRule[]
  loanAccounts     LoanAccount[]
  loanApplications LoanApplication[]

  @@unique([loanProductId, versionNumber])
  @@map("loan_product_versions")
}

/// PEN-1..4. ADR-008 PENDING: capPercent is a mechanism only (matches the
/// legacy `penalty_rate.maximum` field, which existed but was unused in
/// all 44 sampled products) — not enforced by default until the cap
/// policy decision is made.
model PenaltyRule {
  id                   String                   @id @default(uuid())
  loanProductVersionId String                   @unique
  loanProductVersion   LoanProductVersion       @relation(fields: [loanProductVersionId], references: [id])
  calculationMethod    PenaltyCalculationMethod @default(NONE)
  ratePercent          Decimal?                 @db.Decimal(6, 3)
  capPercent           Decimal?                 @db.Decimal(6, 3)
  gracePeriodDays      Int                      @default(0)

  @@map("penalty_rules")
}

/// FEE-1..4.
model FeeRule {
  id                   String               @id @default(uuid())
  loanProductVersionId String
  loanProductVersion   LoanProductVersion   @relation(fields: [loanProductVersionId], references: [id])
  name                 String
  calculationMethod    FeeCalculationMethod
  triggerEvent         FeeTriggerEvent
  applicationType      FeeApplicationType   @default(REQUIRED)
  flatAmount           Decimal?             @db.Decimal(14, 2)
  percentage           Decimal?             @db.Decimal(6, 3)
  isActive             Boolean              @default(true)

  legacyId  String?  @unique
  createdAt DateTime @default(now())

  appliedFees AppliedFee[]

  @@map("fee_rules")
}

// ----------------------------------------------------------------------------
// Borrower — BOR-1..4
// ADR-001: "Borrower" is the canonical term (recommended option adopted);
// legacy "Client" naming is a migration-mapping concern only.
// ADR-014: Address is polymorphic (Borrower or Co-Borrower) — documented,
// not just assumed.
// ADR-040: Guarantor is out of scope for this schema (deferred).
// ----------------------------------------------------------------------------

model Borrower {
  id                    String  @id @default(uuid())
  branchId              String
  branch                Branch  @relation(fields: [branchId], references: [id])
  assignedLoanOfficerId String?
  assignedLoanOfficer   User?   @relation("BorrowerLoanOfficer", fields: [assignedLoanOfficerId], references: [id])

  /// Set when this Borrower was created via "Create Client Profile" from an APPROVED
  /// LoanApplication (see CreateBorrowerUseCase) - lets the application detail page know a
  /// client already exists for it and prevents creating a duplicate. Null for borrowers created
  /// any other way (e.g. legacy migration, direct walk-in without an application on file).
  sourceApplicationId String?         @unique
  sourceApplication   LoanApplication? @relation(fields: [sourceApplicationId], references: [id])

  firstName     String
  middleName    String?
  lastName      String
  gender        String?
  birthDate     DateTime?
  placeOfBirth  String?
  nationality   String?
  civilStatus   String?
  homeOwnership String?
  mobilePhone1  String?
  mobilePhone2  String?
  email         String?
  /// {name, age, relationship}[] - see LoanApplication.dependants doc comment.
  dependants    Json?
  /// Free-text catch-all, carried over from the source LoanApplication's own `note` at Client
  /// Profile creation; also directly editable afterward.
  note          String?
  status        BorrowerStatus @default(ACTIVE)
  loanCycle     Int            @default(0)

  legacyId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incomeDetail        BorrowerIncomeDetail?
  governmentId        BorrowerGovernmentId?
  identificationDocs  IdentificationDocument[]
  characterReferences CharacterReference[]
  loanAccounts        LoanAccount[]

  /// Schema Review SR-06/SR-07/SR-08: branch/officer/status filtering and
  /// name/phone search (PROJECT_RULES.md §Search) were previously unindexed.
  @@index([branchId])
  @@index([assignedLoanOfficerId])
  @@index([status])
  @@index([lastName])
  @@index([firstName])
  @@index([mobilePhone1])
  @@map("borrowers")
}

model BorrowerIncomeDetail {
  id               String   @id @default(uuid())
  borrowerId       String   @unique
  borrower         Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  employmentType   String?
  employerName     String?
  employerAddress  String?
  natureOfBusiness String?
  position         String?
  yearsEmployed    Int?

  @@map("borrower_income_details")
}

model BorrowerGovernmentId {
  id         String   @id @default(uuid())
  borrowerId String   @unique
  borrower   Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  sssNumber  String?
  tinNumber  String?

  @@map("borrower_government_ids")
}

/// Philippine Standard Geographic Code reference data — read-only lookup tables imported from the
/// legacy `db-address-api` Mongo dump (scripts/import-psgc-reference-data.ts). Used to decode the
/// raw PSGC codes some legacy borrower addresses were stored as (see scripts/fix-coded-addresses.ts)
/// and, going forward, to back a real cascading Region -> Province -> City/Municipality -> Barangay
/// picker instead of free-text entry.
model PsgcRegion {
  code      String         @id
  name      String
  provinces PsgcProvince[]

  @@map("psgc_regions")
}

model PsgcProvince {
  code       String                 @id
  name       String
  regionCode String
  region     PsgcRegion             @relation(fields: [regionCode], references: [code])
  cities     PsgcCityMunicipality[]

  @@index([regionCode])
  @@map("psgc_provinces")
}

model PsgcCityMunicipality {
  code         String         @id
  name         String
  provinceCode String
  province     PsgcProvince   @relation(fields: [provinceCode], references: [code])
  barangays    PsgcBarangay[]

  @@index([provinceCode])
  @@map("psgc_city_municipalities")
}

model PsgcBarangay {
  code                 String               @id
  name                 String
  cityMunicipalityCode String
  cityMunicipality     PsgcCityMunicipality @relation(fields: [cityMunicipalityCode], references: [code])

  @@index([cityMunicipalityCode])
  @@map("psgc_barangays")
}

/// ADR-014: polymorphic owner (Borrower or Co-Borrower) — a direct sample
/// cross-reference during Phase 0 exploration showed an address attached
/// to a Co-Borrower's own ID, not only to a Borrower.
model Address {
  id                 String           @id @default(uuid())
  ownerType          AddressOwnerType
  ownerId            String
  addressType        String?
  houseUnitNumber    String?
  street             String?
  barangay           String?
  cityMunicipality   String?
  province           String?
  zipCode            String?
  lengthOfStayMonths Int?
  ownershipStatus    String?

  createdAt DateTime @default(now())

  @@index([ownerType, ownerId])
  @@map("addresses")
}

model IdentificationDocument {
  id               String    @id @default(uuid())
  borrowerId       String
  borrower         Borrower  @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  documentType     String
  documentNumber   String
  issuingAuthority String?
  validUntil       DateTime?

  /// Schema Review SR-09: supports search by Government ID (PROJECT_RULES.md §Search).
  @@index([documentNumber])
  @@map("identification_documents")
}

/// ADR-013: optional by default (only 54 of 4,629 legacy clients had one).
model CharacterReference {
  id           String   @id @default(uuid())
  borrowerId   String
  borrower     Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  relationship String?
  phoneNumber  String?
  emailAddress String?

  @@map("character_references")
}

/// ADR-015 PENDING (per-Borrower vs per-LoanAccount scope): modeled as its
/// own person entity plus a many-to-many join table to LoanAccount. This
/// is a safe extension point compatible with either resolution of the
/// open ADR — a "per-loan" policy just means each CoBorrower row has
/// exactly one join row; a "reusable across loans" policy means several.
model CoBorrower {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  gender       String?
  civilStatus  String?
  birthDate    DateTime?
  phoneNumber  String?
  emailAddress String?
  relationship String?
  employer     String?

  legacyId String? @unique

  loanAccounts LoanAccountCoBorrower[]

  @@map("co_borrowers")
}

model LoanAccountCoBorrower {
  loanAccountId String
  coBorrowerId  String
  loanAccount   LoanAccount @relation(fields: [loanAccountId], references: [id], onDelete: Cascade)
  coBorrower    CoBorrower  @relation(fields: [coBorrowerId], references: [id], onDelete: Cascade)

  @@id([loanAccountId, coBorrowerId])
  @@map("loan_account_co_borrowers")
}

// ----------------------------------------------------------------------------
// Loan Account & Ledger — LA-1..5, TXN-1..4, REPAY-1..4
// ADR-007: no stored `outstandingBalance` column — computed in the domain
// layer from components; single point of change once the formula is
// confirmed.
// ADR-010 (Critical/compliance): addOn/contractual interest columns exist,
// no derivation or disclosure logic until resolved.
// ADR-004 (PENDING, intentionally deferred): legacy `loan_accounts` has an
// `accountHolderType` that can be GROUP as well as CLIENT/individual. This
// schema intentionally supports individual Borrower-held loans only —
// `LoanAccount.borrowerId` is a required FK to `Borrower`, with no Group
// entity or polymorphic account-holder concept. This is a deliberate,
// tracked scope limit for Phase 1, not an oversight (see Schema Review
// SR-01); introducing Group-held loans is out of scope for this migration
// and requires ADR-004 to be resolved and a dedicated design pass first.
// ADR-032 (PENDING, working assumption only): "Loan Release" vs.
// "Disbursement" — whether these are one event or two — is unresolved.
// This schema takes the position that they are two distinct moments:
// `LoanAccount.activatedAt` represents the loan being released/booked,
// while the `DISBURSEMENT`-typed `LoanTransaction.entryDate` represents
// the actual funds-disbursement event. This is a working assumption, not
// a resolution of ADR-032 — revisit both fields' semantics once ADR-032
// is formally decided.
// ----------------------------------------------------------------------------

model LoanAccount {
  id                   String             @id @default(uuid())
  loanCode             String             @unique
  borrowerId           String
  borrower             Borrower           @relation(fields: [borrowerId], references: [id])
  loanProductVersionId String
  loanProductVersion   LoanProductVersion @relation(fields: [loanProductVersionId], references: [id])
  branchId             String
  branch               Branch             @relation(fields: [branchId], references: [id])
  loanOfficerId        String?
  loanOfficer          User?              @relation("LoanAccountOfficer", fields: [loanOfficerId], references: [id])

  status LoanAccountStatus @default(PENDING_APPROVAL)

  principalAmount  Decimal @db.Decimal(14, 2)
  principalBalance Decimal @default(0) @db.Decimal(14, 2)
  principalPaid    Decimal @default(0) @db.Decimal(14, 2)
  principalDue     Decimal @default(0) @db.Decimal(14, 2)

  /// Snapshot at approval — LA-4. Never recomputed from a later product edit.
  interestRate            Decimal  @db.Decimal(6, 3)
  addOnInterestRate       Decimal? @db.Decimal(6, 3)
  contractualInterestRate Decimal? @db.Decimal(6, 3)
  interestBalance         Decimal  @default(0) @db.Decimal(14, 2)
  interestPaid            Decimal  @default(0) @db.Decimal(14, 2)
  interestDue             Decimal  @default(0) @db.Decimal(14, 2)

  feesBalance Decimal @default(0) @db.Decimal(14, 2)
  feesPaid    Decimal @default(0) @db.Decimal(14, 2)
  feesDue     Decimal @default(0) @db.Decimal(14, 2)

  penaltyBalance Decimal @default(0) @db.Decimal(14, 2)
  penaltyPaid    Decimal @default(0) @db.Decimal(14, 2)
  penaltyDue     Decimal @default(0) @db.Decimal(14, 2)

  installmentCount    Int
  repaymentPeriodUnit RepaymentPeriodUnit @default(MONTHS)
  gracePeriodDays     Int                 @default(0)

  /// ADR-045 (Concept 1 — Exact First Repayment Date): an explicit input
  /// supplied at origination, never computed/derived from disbursement
  /// date or any other field — no recoverable generation rule exists in
  /// this system's evidence base (see ADR-045 §1-§3). Used as the anchor
  /// date for RepaymentInstallment schedule generation at activation
  /// (Milestone 9.1 checkpoint 8); subsequent installments are spaced from
  /// this date by repaymentPeriodUnit.
  firstRepaymentDate DateTime

  approvedAt       DateTime?
  approvedByUserId String?
  approvedBy       User?     @relation("LoanAccountApprovedBy", fields: [approvedByUserId], references: [id])
  activatedAt      DateTime?
  closedAt         DateTime?
  closedReason     String?

  /// CP12 migration follow-up (2026-07-09): true for a loan whose legacy record had NO
  /// account-level balance snapshot fields at all (principalBalance/interestBalance/feesBalance/
  /// penaltyBalance all absent, not zero) — 624 of 1,805 migrated loans, 191 of them
  /// Active/ActiveInArrears. All balance columns on those rows were migrated as 0.00 for lack of
  /// any other value, which would misleadingly read as "fully settled" — this flag exists so
  /// staff can tell "genuinely zero" apart from "balance unknown, needs manual reconciliation".
  /// Never set for a loan created going forward through this system's own
  /// ActivateLoanUseCase/ProcessPaymentUseCase, which always populate real balances.
  legacyBalanceDataMissing Boolean @default(false)

  /// 2026-07-11 (Create Loan Account, origination fees): one-time deductions taken at
  /// disbursement — distinct from feesBalance/feesPaid/feesDue above, which track recurring
  /// per-installment fees. Staff-entered amounts, not auto-computed from a fixed formula, per
  /// `docs/Architecture/LEGACY_EXCEL_LMS_REFERENCE.md` — real data (Loans_details, BETA 1.5.83
  /// LMSv3.xlsm) shows most of these vary too much per loan to derive a reliable per-product
  /// formula (confirmed: only Account Management Fee at exactly 1% of principal when charged).
  /// advanceInterestFee's real formula IS confirmed separately (ADR-046) but is still captured
  /// here as a plain entered amount, not recomputed by this schema.
  processingFee            Decimal @default(0) @db.Decimal(14, 2)
  advanceInterestFee       Decimal @default(0) @db.Decimal(14, 2)
  /// Previous loan's remaining balance, paid off from this loan's proceeds — the renewal case.
  outstandingBalancePayoff Decimal @default(0) @db.Decimal(14, 2)
  docStampFee              Decimal @default(0) @db.Decimal(14, 2)
  accountManagementFee     Decimal @default(0) @db.Decimal(14, 2)
  otherFees                Decimal @default(0) @db.Decimal(14, 2)
  notarialFee              Decimal @default(0) @db.Decimal(14, 2)
  webFee                   Decimal @default(0) @db.Decimal(14, 2)
  insuranceFee             Decimal @default(0) @db.Decimal(14, 2)
  /// = principalAmount - (sum of the 9 fee/payoff fields above). Computed once at creation, never
  /// recomputed later — matches every other origination snapshot field's LA-4 treatment.
  netProceeds              Decimal @default(0) @db.Decimal(14, 2)

  legacyId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ADR-048-optimistic-concurrency: optimistic concurrency control for every
  /// balance-mutating write. Every conditional update increments this and
  /// checks it in the same `WHERE` clause; a zero-row result means another
  /// writer moved first, and the caller must receive a
  /// `ConcurrencyConflictError`, never a silent overwrite.
  version Int @default(0)

  transactions       LoanTransaction[]
  repaymentSchedule  RepaymentSchedule[]
  appliedFees        AppliedFee[]
  coBorrowers        LoanAccountCoBorrower[]
  notes              LoanNote[]
  generatedDocuments GeneratedLoanDocument[]

  /// Schema Review SR-10: branch dashboards and Loan Officer Performance
  /// reports (PROJECT_RULES.md §Reports) were previously unindexed.
  @@index([borrowerId])
  @@index([status])
  @@index([branchId])
  @@index([loanOfficerId])
  @@map("loan_accounts")
}

/// TXN-1: append-only. Corrections are new, explicitly linked reversal
/// transactions — never edits or deletes of an existing row.
model LoanTransaction {
  id            String              @id @default(uuid())
  loanAccountId String
  loanAccount   LoanAccount         @relation(fields: [loanAccountId], references: [id])
  type          LoanTransactionType

  amount             Decimal @db.Decimal(14, 2)
  principalComponent Decimal @default(0) @db.Decimal(14, 2)
  interestComponent  Decimal @default(0) @db.Decimal(14, 2)
  feesComponent      Decimal @default(0) @db.Decimal(14, 2)
  penaltyComponent   Decimal @default(0) @db.Decimal(14, 2)
  balanceAfter       Decimal @db.Decimal(14, 2)

  postedByUserId String?
  postedBy       User?    @relation("LoanTransactionPostedBy", fields: [postedByUserId], references: [id])
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id])
  entryDate      DateTime
  comment        String?

  /// Official Receipt number — required on every REPAYMENT posted through
  /// Payment Recording (2026-07-11 user request), matching the SDevTech
  /// system's own OR#/AR# fields (also independently found in MIS Nomer's
  /// own Excel LMS's Payment_History sheet — see
  /// docs/Architecture/LEGACY_EXCEL_LMS_REFERENCE.md §3.1). Nullable at the
  /// schema level because non-REPAYMENT transaction types (DISBURSEMENT,
  /// ADJUSTMENT, etc.) have no receipt to record — requiredness for
  /// REPAYMENT specifically is enforced by processPaymentSchema, not here.
  orNumber String?
  /// Acknowledgment Receipt number — optional; not every payment channel
  /// issues one.
  arNumber String?

  /// Present on a transaction that IS a reversal — points to the original
  /// transaction it corrects (TXN-1).
  reversesTransactionId String?          @unique
  reversesTransaction   LoanTransaction? @relation("LoanTransactionReversal", fields: [reversesTransactionId], references: [id])
  reversedByTransaction LoanTransaction? @relation("LoanTransactionReversal")

  legacyId  String?  @unique
  createdAt DateTime @default(now())

  appliedFees        AppliedFee[]
  /// 2026-07-11 (Reverse Payment): per-installment breakdown of this
  /// transaction's effect — see `PaymentAllocation`'s own doc comment for
  /// why this exists. Present on REPAYMENT (and, going forward, REVERSAL)
  /// transactions; empty for every other type.
  paymentAllocations PaymentAllocation[]

  /// Schema Review SR-11 (Critical): `loan_transactions` is the highest-
  /// volume table (legacy equivalent: 524k rows) — date-range and
  /// officer/branch-filtered transaction reports were previously unindexed.
  @@index([loanAccountId])
  @@index([type])
  @@index([entryDate])
  @@index([postedByUserId])
  @@index([branchId])
  @@map("loan_transactions")
}

/// REPAY-1..4. Note: legacy tax_* / organization-commission / funders-interest
/// fields are intentionally dropped (ADR-028: consistently zero across all
/// sampled legacy records — YAGNI; can be reintroduced if a genuine
/// multi-funder/tax feature is confirmed later).
model RepaymentSchedule {
  id                String      @id @default(uuid())
  loanAccountId     String
  loanAccount       LoanAccount @relation(fields: [loanAccountId], references: [id])
  installmentNumber Int
  dueDate           DateTime

  principalDue  Decimal @default(0) @db.Decimal(14, 2)
  interestDue   Decimal @default(0) @db.Decimal(14, 2)
  feesDue       Decimal @default(0) @db.Decimal(14, 2)
  penaltyDue    Decimal @default(0) @db.Decimal(14, 2)
  principalPaid Decimal @default(0) @db.Decimal(14, 2)
  interestPaid  Decimal @default(0) @db.Decimal(14, 2)
  feesPaid      Decimal @default(0) @db.Decimal(14, 2)
  penaltyPaid   Decimal @default(0) @db.Decimal(14, 2)

  status     RepaymentInstallmentStatus @default(PENDING)
  lastPaidAt DateTime?

  legacyId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ADR-048-optimistic-concurrency: same optimistic concurrency mechanism as
  /// `LoanAccount.version` — see that field's comment for the full
  /// rationale. Applied here too for consistency, per the ADR's decision
  /// to scope this to every balance-mutating aggregate, not just one.
  version Int @default(0)

  paymentAllocations PaymentAllocation[]

  /// Schema Review SR-12 (Critical): Aging, Delinquency, Expected
  /// Collection, and Daily Collection reports (PROJECT_RULES.md §Reports)
  /// all filter on due date and status — previously unindexed beyond
  /// (loanAccountId, installmentNumber).
  @@unique([loanAccountId, installmentNumber])
  @@index([dueDate])
  @@index([status])
  @@map("repayment_schedules")
}

/// 2026-07-11 (Reverse Payment feature). `ProcessPaymentUseCase` applies one
/// payment across possibly several installments (`ADR-009`'s waterfall, or a
/// staff-entered manual split) but only ever persisted the AGGREGATE
/// principal/interest/fees/penalty totals on the resulting `LoanTransaction`
/// — no record existed of exactly which installment(s), and how much of
/// each component, that one transaction actually touched. That's fine for
/// display, but not enough to safely reverse a specific past payment later
/// (undoing the wrong installment, or the wrong amount, would itself be a
/// financial error) — especially once other payments have touched the same
/// loan afterward. This table closes that gap: one row per
/// (transaction, installment) pair a REPAYMENT transaction affected, with
/// the exact per-component amounts applied. `ReversePaymentUseCase` reads
/// these rows back to know precisely what to undo, per installment, then
/// negates them via the same `RepaymentInstallment.recordPayment()` /
/// `LoanAccount.applyPayment()` primitives `ProcessPaymentUseCase` itself
/// uses (Money/InstallmentAmounts/TransactionComponents already support
/// negative amounts — see `Money`'s own doc comment). Written going forward
/// only; not backfilled for transactions recorded before this feature
/// existed — those remain reversible only by the older, coarser workaround
/// (a manual ADJUSTMENT transaction), same as before this feature.
model PaymentAllocation {
  id                     String            @id @default(uuid())
  loanTransactionId      String
  loanTransaction        LoanTransaction   @relation(fields: [loanTransactionId], references: [id])
  repaymentInstallmentId String
  repaymentInstallment   RepaymentSchedule @relation(fields: [repaymentInstallmentId], references: [id])

  principalApplied Decimal @default(0) @db.Decimal(14, 2)
  interestApplied  Decimal @default(0) @db.Decimal(14, 2)
  feesApplied      Decimal @default(0) @db.Decimal(14, 2)
  penaltyApplied   Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([loanTransactionId])
  @@index([repaymentInstallmentId])
  @@map("payment_allocations")
}

/// 2026-07-11 (user request, Collections use case): a free-text note tied to a loan account —
/// e.g. what was discussed/agreed with the borrower during a collection call. Deliberately simple
/// (just text + author + timestamp, no structured fields like contact method or outcome code) per
/// explicit user decision — flexibility over structure. Append-only, like AppliedFee/PaymentAllocation:
/// no update/delete anywhere in this system: a correction is a new note, not an edit of history.
model LoanNote {
  id            String      @id @default(uuid())
  loanAccountId String
  loanAccount   LoanAccount @relation(fields: [loanAccountId], references: [id])
  authorUserId  String
  author        User        @relation(fields: [authorUserId], references: [id])
  text          String

  createdAt DateTime @default(now())

  @@index([loanAccountId])
  @@map("loan_notes")
}

/// FEE-4: once applied to a specific loan, a fee amount is immutable even
/// if the underlying FeeRule is later edited.
model AppliedFee {
  id            String           @id @default(uuid())
  loanAccountId String
  loanAccount   LoanAccount      @relation(fields: [loanAccountId], references: [id])
  feeRuleId     String
  feeRule       FeeRule          @relation(fields: [feeRuleId], references: [id])
  amount        Decimal          @db.Decimal(14, 2)
  taxAmount     Decimal          @default(0) @db.Decimal(14, 2)
  appliedAt     DateTime         @default(now())
  transactionId String?
  transaction   LoanTransaction? @relation(fields: [transactionId], references: [id])

  legacyId String? @unique

  @@map("applied_fees")
}

// ----------------------------------------------------------------------------
// Documents — DOC-1..4
// DOC-3: storage location is abstracted behind IStorageService; storageKey
// is an opaque key resolved by whichever adapter (local disk now,
// S3-compatible later) is configured. ADR-006 (physical legacy file blobs
// unresolved) does not block this table — it only blocks migrating the
// 21,104 legacy attachment records' actual files, which is out of scope
// for this build per the agreed migration-scope decision.
// ----------------------------------------------------------------------------

model Attachment {
  id               String              @id @default(uuid())
  ownerType        AttachmentOwnerType
  ownerId          String
  fileName         String
  fileType         String
  /// Bytes on disk — absent for pre-existing legacy-migrated rows (nullable), always set for
  /// uploads through the new attachment-upload feature (2026-07-10).
  fileSize         Int?
  storageKey       String
  documentCategory AttachmentDocumentCategory?
  uploadedByUserId String?
  uploadedBy       User?               @relation("AttachmentUploadedBy", fields: [uploadedByUserId], references: [id])
  uploadedAt       DateTime            @default(now())

  legacyId String? @unique

  @@index([ownerType, ownerId])
  @@map("attachments")
}

enum NoteOwnerType {
  BORROWER
  LOAN_ACCOUNT
  LOAN_APPLICATION
}

/// Free-text note attached to a Borrower/LoanAccount/LoanApplication - same polymorphic
/// ownerType/ownerId shape as `Attachment` (ADR-014), for the same reason: no dedicated FK relation
/// per owner type. Immutable once created (no edit/delete use case) - a running log, not a wiki.
///
/// 2026-07-13 (merge note): distinct from the pre-existing `LoanNote` model above, added
/// independently in a parallel branch of work on the same day — both model "a free-text note on a
/// loan," `LoanNote` scoped to loan accounts only, `Note` generalized to Borrower/LoanApplication
/// too. Kept both as-is rather than unify them mid-merge (a real product decision, not a merge
/// mechanic); flagged as a follow-up to resolve deliberately once the merge itself is verified.
model Note {
  id           String        @id @default(uuid())
  ownerType    NoteOwnerType
  ownerId      String
  text         String
  authorUserId String
  author       User          @relation("NoteAuthor", fields: [authorUserId], references: [id])
  createdAt    DateTime      @default(now())

  @@index([ownerType, ownerId])
  @@map("notes")
}

/// ADR-051: repurposes the table originally scaffolded (init migration) for the legacy SDevTech
/// `document_templates` collection (`contentHtml`, HTML-based) — that migration path was
/// investigated and deliberately NOT taken (ADR-051 §6: 507 rows collapse to 365 sprawling
/// historical variants, and the per-product mapping references a Mambu-era product catalog that
/// doesn't join to any currently-migrated `LoanProductVersion.legacyId`). Nothing in `src/` ever
/// referenced the old shape, so no data migration is needed — this is the first real use of these
/// two tables.
///
/// One row per document type (11 total: 4 required + 7 conditional — see ADR-051 §1). `code` is
/// the stable identifier the generation code uses to find the matching `.docx` file under
/// `app/backend/templates/`. Required documents (`isRequired: true`) apply to every loan and have
/// no `DocumentTemplateMapping` rows; conditional documents are linked to the Loan Products they
/// apply to via that table.
model DocumentTemplate {
  id         String  @id @default(uuid())
  code       String  @unique
  name       String
  isRequired Boolean @default(false)
  sortIndex  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productLinks       DocumentTemplateMapping[]
  generatedDocuments GeneratedLoanDocument[]

  @@map("document_templates")
}

/// Only ever holds CONDITIONAL document templates (ADR-051 §1/§3) — required templates apply
/// universally and never get a row here, so this table's size reflects only the per-product
/// variation, not every template x every product.
model DocumentTemplateMapping {
  loanProductId      String
  documentTemplateId String
  loanProduct        LoanProduct      @relation(fields: [loanProductId], references: [id], onDelete: Cascade)
  documentTemplate   DocumentTemplate @relation(fields: [documentTemplateId], references: [id], onDelete: Cascade)

  @@id([loanProductId, documentTemplateId])
  @@map("document_template_mappings")
}

/// Append-only (ADR-051 §3) — matches this project's ledger philosophy (TXN-1, `LoanNote`,
/// `PaymentAllocation`): "Regenerate" in the UI always inserts a new row rather than overwriting,
/// so a document a borrower has already been shown/signed is never silently erased from the
/// record, even after a later data correction. The Documents tab shows the latest row per
/// `documentTemplateId` for a loan, with older ones available as history.
model GeneratedLoanDocument {
  id            String      @id @default(uuid())
  loanAccountId String
  loanAccount   LoanAccount @relation(fields: [loanAccountId], references: [id])

  documentTemplateId String
  documentTemplate   DocumentTemplate @relation(fields: [documentTemplateId], references: [id])

  /// Key into the existing local storage abstraction (DOC-3, `app/backend/storage/`).
  storageKey String

  generatedByUserId String
  generatedBy       User     @relation("LoanDocumentGeneratedBy", fields: [generatedByUserId], references: [id])
  generatedAt       DateTime @default(now())

  @@index([loanAccountId])
  @@map("generated_loan_documents")
}

// ----------------------------------------------------------------------------
// Audit — AUDIT-1, AUDIT-2
// Append-only. No update/delete path is exposed anywhere in the
// application for this table.
// ----------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  /// Schema Review SR-13: time-range audit browsing and per-user audit
  /// queries were previously unsupported beyond (entityType, entityId).
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// Profile Activity Timeline — ADR-050
// Track loan officer actions on Loan Applications, Borrowers, and Loan Accounts
// for compliance and auditability. Immutable after creation (soft-delete only).
// Separate from AuditLog — this is user-visible activity; AuditLog is
// system-level audit trail.
// ----------------------------------------------------------------------------

enum ProfileType {
  LOAN_APPLICATION
  BORROWER
  LOAN_ACCOUNT
}

model ProfileActivityLog {
  id                   String       @id @default(uuid())
  profileType          ProfileType
  profileId            String
  userId               String
  user                 User         @relation("ProfileActivityLogUser", fields: [userId], references: [id], onDelete: Restrict)
  action               String
  /// JSON object with action-specific details (attachmentId, documentCategory,
  /// decisionStatus, paymentAmount, etc.). See ADR-050 for examples per action type.
  details              Json
  visibilityRestricted Boolean      @default(false)
  createdAt            DateTime     @default(now())
  deletedByMisAt       DateTime?
  /// Soft delete: if set, MIS deleted this record at this time.

  @@index([profileType, profileId])
  @@index([userId])
  @@index([createdAt])
  @@map("profile_activity_logs")
}

// ----------------------------------------------------------------------------
// Idempotency — Milestone 9.1/9.2 CP13
// (docs/Architecture/MILESTONE_9_IMPLEMENTATION_ROADMAP_V2.md, Decision Log
// #9): a client-supplied Idempotency-Key header, checked via this small,
// purpose-built lookup (deliberately separate from AuditLog, which records
// history, not replay state), rejecting a duplicate resubmission before it
// reaches the use case layer.
//
// 2026-07-08 (H-4 fix): statusCode/responseBody are nullable because a row is
// now inserted as a claim BEFORE the use case runs (both null = "in
// progress"), not just after it succeeds. This is what makes the @@unique
// constraint actually block a concurrent duplicate: the second request's
// claim-insert itself hits P2002, before it ever reaches the use case layer,
// instead of only detecting the collision afterward. A row can be deleted by
// `release()` if its own claiming request's use case throws — the only
// update/delete paths this table has, both scoped to the row's own
// still-pending (statusCode IS NULL) state.
// ----------------------------------------------------------------------------

// ----------------------------------------------------------------------------
// Loan Applications — Milestone 9.2
//
// The pre-underwriting intake/review workflow that gates loan account
// creation on the frontend's mock UI (a new/renewal loan account may only be
// created from a specific, still-unconverted APPROVED application). This
// pass covers intake, review, and the approve/decline/revert decision only —
// deliberately NOT the "Approved application -> create Borrower -> create
// LoanAccount" conversion step, which stays a separate follow-up so each
// piece can be verified independently (confirmed with the business owner,
// 2026-07-09).
//
// Fields mirror the frontend's MockLoanApplication only for what this pass
// persists — the paper intake form (ECLC-LOFN01) collects many more fields
// (nickname, TIN, SSS, dependents, character references, etc.) shown on the
// create form for workflow completeness but never persisted even in the mock
// today; not modeled here either pending a real requirement to store them.
// AI risk/recommendation is explicitly a frontend-only rule-based demo, never
// a real ML engine — not modeled backend-side at all.
/// PREAPPROVED/PREDECLINED are computed by LoanApplicationPreQualificationService at creation and
/// re-computed whenever the AI Risk Management Summary is saved (advisory only — the officer makes
/// the real, final APPROVED/DECLINED call; system verdicts never auto-approve or auto-decline).
enum LoanApplicationStatus {
  PREAPPROVED
  PREDECLINED
  APPROVED
  DECLINED
}

enum LoanApplicationAccountType {
  NEW
  RENEWAL
}

model LoanApplication {
  id       String @id @default(uuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  applicantName   String
  age             Int?
  gender          String?
  civilStatus     String?
  birthDate       DateTime?
  placeOfBirth    String?
  nationality     String?
  homeOwnership   String?
  address         String?
  monthlyIncome   Decimal? @db.Decimal(14, 2)
  employer        String?
  occupation      String?
  officeAddress   String?
  tinNumber       String?
  sssNumber       String?
  propertiesOwned String[] @default([])
  creditScore     Int?
  coBorrowerName     String?
  coBorrowerEmployer String?
  mobilePhone     String?
  email           String?
  /// {name, age, relationship}[] - display/reference only, no independent query need (mirrors
  /// `propertiesOwned`'s "small list, no relational value" reasoning).
  dependants      Json?
  reference1Name   String?
  reference1Mobile String?
  reference2Name   String?
  reference2Mobile String?
  /// Free-text catch-all for anything staff wants to note at intake that doesn't have its own
  /// field - carried over as-is into the Client Profile's own `note` field on creation.
  note            String?

  referralSource      String?
  accountType         LoanApplicationAccountType?
  loanPurpose         String?
  requestedCategory   String
  requestedAmount     Decimal                     @db.Decimal(14, 2)
  requestedTermMonths Int
  /// Ticked-checklist of document names the applicant submitted at intake
  /// (e.g. "Valid ID", "Proof of Billing") — no file upload/storage exists
  /// yet, this is metadata only, matching the mock's `submittedDocuments`.
  submittedDocuments  String[]                    @default([])

  encodedByUserId String?
  /// Set only for a walk-in/branch-encoded application (staff filled the
  /// paper form on the applicant's behalf) — null for a self-service intake.
  encodedBy       User?   @relation("LoanApplicationEncodedBy", fields: [encodedByUserId], references: [id])

  status LoanApplicationStatus @default(PREDECLINED)
  /// Cached at creation from geocoding the applicant's address against the assigned branch's
  /// coordinates — null if geocoding failed/was inconclusive (the distance rule fails open in that
  /// case; see LoanApplicationPreQualificationService).
  distanceFromBranchKm Decimal? @db.Decimal(6, 2)

  /// Staff picks the specific product sub-type during review — approval is
  /// blocked until this is set (mirrors the mock UI's rule).
  assignedLoanProductVersionId String?
  assignedLoanProductVersion   LoanProductVersion? @relation(fields: [assignedLoanProductVersionId], references: [id])

  reviewedByUserId String?
  reviewedBy       User?     @relation("LoanApplicationReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  /// Free-text reason recorded on approve/decline/revert — required by the
  /// mock UI's confirmation dialog, kept optional here since the API layer
  /// enforces "required" rather than the schema.
  decisionNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Reverse side of Borrower.sourceApplicationId - set once "Create Client Profile" has been
  /// used on this application.
  createdBorrower Borrower?

  @@index([branchId])
  @@index([status])
  @@map("loan_applications")
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  /// Client-supplied key. Scoped per `endpoint` (below) via the compound
  /// unique constraint, so the same key value reused against two different
  /// endpoints is not treated as a collision.
  key          String
  /// e.g. "POST /loan-accounts/:id/activate" — identifies which action this
  /// key was recorded against; not a free-floating global namespace.
  endpoint     String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null while the claiming request's use case is still running.
  statusCode   Int?
  /// Null while the claiming request's use case is still running.
  responseBody Json?
  createdAt    DateTime @default(now())

  @@unique([key, endpoint])
  @@map("idempotency_keys")
}
